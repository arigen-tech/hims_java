<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Blood_inventory_stock_summary" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="5d2f2805-7435-49c0-a522-b8788fa20049">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="hims_dev_db"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="blood_group_id" class="java.util.Collection" nestedType="java.lang.Long"/>
	<parameter name="component_id" class="java.lang.Long"/>
	<parameter name="from_date" class="java.util.Date"/>
	<parameter name="to_date" class="java.util.Date"/>
	<queryString>
		<![CDATA[select
    mbg.blood_group_name,
    mbc.component_code,
    count(case when bci.inventory_status = 1 then 1 end) as available,
    count(case when bci.inventory_status = 3 then 1 end) as reserved,
    count(case when bci.inventory_status = 2 then 1 end) as allocated,
    count(case when bci.inventory_status = 5 then 1 end) as expired
from blood_component_inventory bci
inner join mas_blood_group mbg on bci.blood_group_id = mbg.blood_group_id
inner join mas_blood_component mbc on bci.component_id = mbc.component_id
where bci.expiry_date >= current_date  
and $X{IN, bci.blood_group_id, blood_group_id}
and ($P{component_id} = 0 or bci.component_id = $P{component_id})
and ($P{from_date} is null or bci.expiry_date >= $P{from_date})
and ($P{to_date} is null or bci.expiry_date <= $P{to_date})
group by mbg.blood_group_name, mbc.component_code]]>
	</queryString>
