	<parameter name="from_date" class="java.util.Date"/>
	<parameter name="to_date" class="java.util.Date"/>
	<parameter name="component_id" class="java.lang.Long"/>
	<parameter name="discard_reason_id" class="java.lang.Long"/>
	<parameter name="donation_type" class="java.lang.Long"/>
	<parameter name="path" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    bci.unit_no,
    mbc.component_code AS component,
    mbg.blood_group_code AS blood_group,
    mbdr.discard_reason_name AS discard_reason,
    bcd.discard_datetime AS discard_date,
    mbdt.donation_type_name AS donation_type
FROM blood_component_discard bcd
left join blood_component_inventory bci on bcd.inventory_id = bci.inventory_id
left join mas_blood_component mbc on bci.component_id = mbc.component_id
left join mas_blood_group mbg on bci.blood_group_id = mbg.blood_group_id
left join mas_blood_discard_reason mbdr on bcd.discard_reason_id = mbdr.discard_reason_id
left join blood_donation_dt bdd on bci.donation_dt_id = bdd.donation_dt_id
left join blood_donation_hdr bdh on bdd.donation_hd_id = bdh.donation_id
left join mas_blood_donation_type mbdt on bdh.donation_type_id = mbdt.donation_type_id
where (bcd.discard_datetime >= $P{from_date} or $P{from_date} is null)
and (bcd.discard_datetime <= $P{to_date} or $P{to_date} is null)
and (bci.component_id = $P{component_id} or $P{component_id} = 0)
and (bcd.discard_reason_id = $P{discard_reason_id} or $P{discard_reason_id} = 0)
and (bdh.donation_type_id = $P{donation_type} or $P{donation_type} = 0)]]>
	</queryString>
