	<parameter name="blood_group_id" class="java.lang.Long"/>
	<parameter name="component_id" class="java.lang.Long"/>
	<parameter name="ward_ot" class="java.lang.Long"/>
	<parameter name="from_date" class="java.util.Date"/>
	<parameter name="to_date" class="java.util.Date"/>
	<parameter name="path" class="java.lang.String"/>
	<queryString>
		<![CDATA[select
	mw.ward_name,
	mbc.component_name ,
	mbg.blood_group_name ,
	brd.fulfilled_units ,
	brd.issued_date ,
	p.uhid_no 
from blood_request_dt brd 
left join blood_request_hd brh on brd.request_hd_id = brh.request_hd_id 
left join mas_ward mw on brh.request_ward_id = mw.ward_id 
left join mas_blood_component mbc on brd.component_id = mbc.component_id
left join mas_blood_group mbg on brh.blood_group_id = mbg.blood_group_id 
left join patient p on brh.patient_id = p.patient_id 
where brd.tracking_status_id = 11
and (brh.blood_group_id = $P{blood_group_id} or $P{blood_group_id} = 0)
and (brd.issued_date >= $P{from_date} or $P{from_date} is null)
and (brd.issued_date <= $P{to_date} or $P{to_date} is null)
and (brd.component_id = $P{component_id} or $P{component_id} = 0)
and (brh.request_ward_id = $P{ward_ot} or $P{ward_ot} = 0)]]>
	</queryString>
