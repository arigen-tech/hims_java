	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="donor_code" class="java.lang.String"/>
	<parameter name="name" class="java.lang.String"/>
	<parameter name="deferral_type" class="java.lang.String"/>
	<parameter name="from_date" class="java.util.Date"/>
	<parameter name="to_date" class="java.util.Date"/>
	<parameter name="path" class="java.lang.String"/>
	<queryString>
		<![CDATA[select
	bd.donor_code,
	concat(bd.first_name ,' ', bd.last_name) as donor_name,
	case
		when bds.deferral_type = 'p' then 'Permanent'
		when bds.deferral_type = 't' then 'Temporary'
	end as deferral_type,
	bds.deferral_reason,
	bds.created_date as start_date,
	bds.deferral_upto_date as end_date,
	bds.created_by as screened_by
from blood_donor bd
inner join blood_donor_screening bds on bd.donor_id = bds.donor_id
where bds.deferral_type is not null 
and ($P{donor_code} is null or bd.donor_code like $P{donor_code})
and ($P{name} IS NULL OR CONCAT(bd.first_name, ' ', bd.last_name) ILIKE CONCAT('%', $P{name}, '%'))
and (bds.deferral_type = $P{deferral_type} or $P{deferral_type} is null)
and (bds.deferral_upto_date >= $P{from_date} or $P{from_date} is null)
and (bds.deferral_upto_date <=$P{to_date} or $P{to_date} is null)
order by bds.screening_date desc, bds.screening_id desc]]>
	</queryString>
