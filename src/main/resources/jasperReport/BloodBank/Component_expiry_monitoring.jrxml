<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Component_expiry_monitoring" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="6ead6aca-00bc-432f-b3ba-2329acab31ad">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="hims_dev_db"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="from_date" class="java.util.Date"/>
	<parameter name="to_date" class="java.util.Date"/>
	<parameter name="component_id" class="java.lang.Long"/>
	<parameter name="blood_group_id" class="java.lang.Long"/>
	<parameter name="inventory_status_id" class="java.lang.Long"/>
	<parameter name="path" class="java.lang.String"/>
	<queryString>
		<![CDATA[select
	bci.unit_no,
	mbc.component_code,
	mbg.blood_group_code,
	bci.expiry_date,
	CASE
	    WHEN (bci.expiry_date - CURRENT_DATE) < 0 THEN 'EXPIRED'
	    ELSE (bci.expiry_date - CURRENT_DATE)::text
	END AS days_left,
	mbis.status_code
from blood_component_inventory bci
inner join mas_blood_component mbc on bci.component_id = mbc.component_id
inner join mas_blood_group mbg on bci.blood_group_id = mbg.blood_group_id
inner join mas_blood_inventory_status mbis on bci.inventory_status = mbis.inventory_status_id
where ($P{from_date} is null or bci.expiry_date >= $P{from_date})
and ($P{to_date} is null or bci.expiry_date <= $P{to_date})
and (bci.component_id = $P{component_id} or $P{component_id} = 0)
and (bci.blood_group_id = $P{blood_group_id} or $P{blood_group_id} = 0)
and (bci.inventory_status = $P{inventory_status_id} or $P{inventory_status_id} = 0)
order by bci.expiry_date]]>
	</queryString>
