	<parameter name="from_date" class="java.util.Date"/>
	<parameter name="to_date" class="java.util.Date"/>
	<parameter name="path" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("")]]></defaultValueExpression>
	</parameter>
	<parameter name="drug_id" class="java.lang.Long">
		<defaultValueExpression><![CDATA[new Long(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="indent_type" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false"/>
	<parameter name="hospital_id" class="java.lang.Long"/>
	<parameter name="department_id" class="java.lang.Long"/>
	<queryString>
		<![CDATA[select
	to_char(sim.issue_date, 'DD/MM/YYYY') as issue_date,
	concat(siim.indent_no, ' / ', md.department_name) as indent_dept,
	concat(msi.nomenclature, ' (', sit.item_id, ')') as item_name_code,
	cast(sit.issued_qty as bigint) as issued_qty,
	sit.expiry_date,
	sit.batch_no,
	concat(sit.brand_name, '/', sit.manufacturer_name) as brand_manufacturer,
	sim.issued_by,
	case siim.indent_type_drug_or_nondrug
		when 'D' then 'Drug'
		when 'N' then 'Non Drug'
	end as indent_type
from store_issue_t sit
left join store_issue_m sim on sim.store_issue_m_id = sit.store_issue_m_id
left join mas_store_item msi on sit.item_id = msi.item_id
left join store_internal_indent_m siim on sim.store_issue_m_id = siim.store_issue_m_id
left join mas_department md on sim.from_store_id = md.department_id
where(cast($P{from_date} as date) is null or sim.issue_date >= cast($P{from_date} as date))
and (cast($P{to_date} as date) is null or sim.issue_date <= cast($P{to_date} as date))
and (sit.item_id = $P{drug_id} or $P{drug_id} = 0)
and (siim.indent_type_drug_or_nondrug = $P{indent_type} or $P{indent_type} is null)
and sim.hospital_id = $P{hospital_id}
and sim.to_dept_id = $P{department_id}
order by sim.issue_date, msi.nomenclature]]>
	</queryString>
