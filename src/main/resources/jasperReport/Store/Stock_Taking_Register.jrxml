	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="path" class="java.lang.String">
		<defaultValueExpression><![CDATA["/Users/rozaltheric/Downloads/arigen_health.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="FromDate" class="java.util.Date">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="ToDate" class="java.util.Date">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="HOSPITAL_ID" class="java.lang.Long"/>
	<parameter name="DEPARTMENT_ID" class="java.lang.Long"/>
	<queryString>
		<![CDATA[select distinct 
	store_stock_taking_m.taking_m_id,
	mas_hospital.hospital_name,
    mas_store_item.pvms_no,
    mas_store_item.nomenclature,
    store_stock_taking_t.batch_no,
    store_stock_taking_t.expiry_date,
    store_stock_taking_t.store_stock_service,
    coalesce(store_stock_taking_t.stock_surplus, cast(0 as bigint)) as stock_surplus,
    coalesce(store_stock_taking_t.stock_deficient, cast(0 as bigint)) as stock_deficient,
    store_stock_taking_t.computed_stock,
    store_stock_taking_t.remarks,
    mas_department.department_name,
    case upper(store_stock_taking_m.status)
        when 'A' then 'Approved'
        when 'R' then 'Rejected'
        when 'P' then 'Pending'
		when 'S' then 'Saved'
        else ''
    end as status
from store_stock_taking_m
left join store_stock_taking_t on store_stock_taking_m.taking_m_id = store_stock_taking_t.taking_m_id
left join mas_store_item on store_stock_taking_t.item_id = mas_store_item.item_id
left join mas_department on store_stock_taking_m.department_id = mas_department.department_id
left join mas_hospital on store_stock_taking_m.hospital_id = mas_hospital.hospital_id
where (store_stock_taking_m.department_id = $P{DEPARTMENT_ID} or $P{DEPARTMENT_ID} = 0)
and (store_stock_taking_m.hospital_id = $P{HOSPITAL_ID} or $P{HOSPITAL_ID} = 0)
and (store_stock_taking_m.physical_date >= $P{FromDate})
and (store_stock_taking_m.physical_date <= $P{ToDate})]]>
	</queryString>
