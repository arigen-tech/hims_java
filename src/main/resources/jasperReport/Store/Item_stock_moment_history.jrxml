<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Item_stock_moment_history" pageWidth="595" pageHeight="842" whenNoDataType="NoDataSection" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="e0c1e2d5-0765-4e8c-acb4-153d069cf589">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="hims_db_uat"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="path" class="java.lang.String">
		<defaultValueExpression><![CDATA["/Users/rozaltheric/Downloads/arigen_health.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="hospital_id" class="java.lang.Long"/>
	<parameter name="department_id" class="java.lang.Long"/>
	<parameter name="item_id" class="java.lang.Long"/>
	<parameter name="batch_no" class="java.lang.String"/>
	<queryString>
		<![CDATA[select
	mh.hospital_id,
	mh.hospital_name,
	md.department_name,
	msi.item_id,
	msi.nomenclature,
	sibs.batch_no,
	to_char(ssl.created_dt, 'dd/mm/yyyy') as txn_date,
	ssl.txn_type,
	ssl.reference_number,
	ssl.txn_source,
	coalesce(ssl.qty_before, 0) as qty_before,
	coalesce(ssl.qty_in, 0) as qty_in,
	coalesce(ssl.qty_out, 0) as qty_out,
	coalesce(ssl.qty_after, 0) as qty_after,
	ssl.remarks
from store_stock_ledger ssl
left join store_item_batch_stock sibs on ssl.stock_id = sibs.stock_id
left join mas_store_item msi on sibs.item_id =msi.item_id
left join mas_department md on ssl.department_id = md.department_id
left join mas_hospital mh on ssl.hospital_id = mh.hospital_id
where ssl.hospital_id = $P{hospital_id}
and ssl.department_id = $P{department_id}
and sibs.item_id = $P{item_id}
and sibs.batch_no = $P{batch_no}
order by ssl.created_dt asc]]>
	</queryString>
