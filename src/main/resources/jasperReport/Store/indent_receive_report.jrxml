	<parameter name="path" class="java.lang.String">
		<defaultValueExpression><![CDATA["/Users/rozaltheric/Downloads/arigen_health.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="receive_m_id" class="java.lang.Long"/>
	<queryString>
		<![CDATA[select distinct
	mh.hospital_name,
	md.department_name as from_department,
	siim.indent_no,
	to_char(siim.indent_date, 'dd/MM/yyyy') as indent_date,
	to_char(siim.received_date, 'dd/MM/yyyy') as received_date,
	sim.issue_no as civno,
	hd.received_by,
	msi.pvms_no,
	msi.nomenclature,
	msu.unit_name,
	dt.expiry_date,
	dt.batch_no,
	concat(dt.brand_name, '/', dt.manufacturer_name) as brand_manufacturer,
	cast(dt.issued_qty as bigint) as issued_qty,
	cast((dt.received_qty * sit.unit_price) as numeric(14,2)) as total_cost,
	sit.unit_price as unit_price,
	coalesce(cast(dt.received_qty as bigint), 0) as received_qty,
	case siim.indent_type_drug_or_nondrug
		when 'D' then 'Drug'
		when 'N' then 'Non Drug'
	end as indent_type
from store_indent_receive_t dt
left join store_indent_receive_m hd on dt.receive_m_id = hd.receive_m_id
left join mas_department md on hd.received_dept_id = md.department_id
left join store_issue_t sit on dt.store_issue_t_id = sit.store_issue_t_id
left join store_issue_m sim on sit.store_issue_m_id = sim.store_issue_m_id
left join mas_store_item msi on dt.item_id = msi.item_id
left join mas_store_unit msu on msi.unit_au = msu.unit_id
left join store_internal_indent_t siit on dt.indent_t_id = siit.indent_t_id
left join store_internal_indent_m siim on siit.indent_m_id = siim.indent_m_id
left join mas_hospital mh on sim.hospital_id = mh.hospital_id
where dt.receive_m_id = $P{receive_m_id}]]>
	</queryString>
