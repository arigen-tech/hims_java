	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="hims_db_uat"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="path" class="java.lang.String">
		<defaultValueExpression><![CDATA[new String(" ")]]></defaultValueExpression>
	</parameter>
	<parameter name="TAKING_M_ID" class="java.lang.Long"/>
	<queryString>
		<![CDATA[select
	store_stock_taking_m.taking_m_id,
	mas_hospital.hospital_name,
    mas_store_item.pvms_no,
    mas_store_item.nomenclature,
    store_stock_taking_t.batch_no,
    store_stock_taking_t.expiry_date,
    store_stock_taking_t.store_stock_service,
	coalesce(store_stock_taking_t.stock_surplus, cast(0 as bigint)) as physical_stock,
	coalesce(store_stock_taking_t.stock_deficient, cast(0 as bigint)) as stock_deficient,
    store_stock_taking_t.computed_stock,
    store_stock_taking_t.remarks,
    case upper(store_stock_taking_m.status)
        when 'A' then 'approved'
        when 'R' then 'rejected'
		when 'P' then 'Pending'
		when 'S' then 'Saved'
        else ''
    end as status,
    store_stock_taking_m.stock_taking_no,
    store_stock_taking_m.physical_date,
    mas_department.department_name,
    store_stock_taking_m.reason,
	store_stock_taking_m.created_by,
	store_stock_taking_m.approved_by
from store_stock_taking_m
left outer join store_stock_taking_t on store_stock_taking_m.taking_m_id = store_stock_taking_t.taking_m_id
left outer join mas_store_item on store_stock_taking_t.item_id = mas_store_item.item_id
left outer join mas_department on store_stock_taking_m.department_id = mas_department.department_id
left join mas_hospital on store_stock_taking_m.hospital_id = mas_hospital.hospital_id
where store_stock_taking_m.taking_m_id = $P{TAKING_M_ID}
order by mas_store_item.nomenclature]]>
	</queryString>
