	</parameter>
	<parameter name="issue_m_id" class="java.lang.Long"/>
	<queryString>
		<![CDATA[select distinct
	siim.indent_no,
	to_char(siim.indent_date, 'dd/MM/yyyy') as indent_date,
	to_char(sim.issue_date, 'dd/MM/yyyy') as issue_date,
	sim.issue_no as civno,
	msi.pvms_no,
	msi.nomenclature,
	sibs.expiry_date,
	sibs.manufacture_date,
	msu.unit_name,
	sibs.batch_no,
	cast(siit.requested_qty as bigint) requested_qty,
	cast(sit.issued_qty as bigint) as issued_qty,
	md.department_name,
	mh.hospital_name,
	sim.issued_by,
	md.department_name as from_department,
	md1.department_name as to_department,
	cast((sit.unit_price * sit.issued_qty)as decimal(14, 2)) as total_cost,
	concat(sit.brand_name, '/', sit.manufacturer_name) as brand_manufacturer,
	sit.unit_price as unit_price,
	case siim.indent_type_drug_or_nondrug
		when 'D' then 'Drug'
		when 'N' then 'Non Drug'
	end as indent_type
from store_issue_t sit
left join store_issue_m sim on sit.store_issue_m_id = sim.store_issue_m_id
left join mas_department md on sim.from_store_id = md.department_id
left join mas_department md1 on sim.to_dept_id = md1.department_id
left join mas_store_item msi on msi.item_id = sit.item_id
left join store_item_batch_stock sibs on sit.stock_id = sibs.stock_id
left join mas_store_unit msu on msi.unit_au = msu.unit_id
left join store_internal_indent_m siim on sim.store_issue_m_id = siim.store_issue_m_id
left join mas_hospital mh on sim.hospital_id = mh.hospital_id
left join store_internal_indent_t siit on siim.indent_m_id = siit.indent_m_id and siit.item_id = sit.item_id
where sim.store_issue_m_id = $P{issue_m_id}]]>
	</queryString>
