	<parameter name="path" class="java.lang.String">
		<defaultValueExpression><![CDATA["/Users/rozaltheric/Downloads/arigen_health.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="hospital_id" class="java.lang.Long"/>
	<parameter name="from_date" class="java.util.Date">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="to_date" class="java.util.Date">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	mh.hospital_name,
    msc.service_cat_name,
    count(distinct bd.bill_hd_id) as bills,
    sum(bd.base_price) as gross_amount,
    sum(bd.discount) as discount,
    sum(bd.tax_amount) as taxable_amount,
    sum(bd.net_amount) as net_amount,
    sum(case when pd.payment_mode = 'cash' then bd.net_amount else 0 end) as cash,
    sum(case when pd.payment_mode = 'upi' then bd.net_amount else 0 end) as upi,
    sum(case when pd.payment_mode = 'card' then bd.net_amount else 0 end) as card
from billing_details bd
left join billing_header bh on bd.bill_hd_id = bh.bill_hd_id
left join mas_service_category msc on bd.service_category_id = msc.id
left join (
    select billing_hd_id, max(payment_mode) as payment_mode
    from payment_details
    group by billing_hd_id
) pd on bd.bill_hd_id = pd.billing_hd_id
left join mas_hospital mh on bh.hospital_id = mh.hospital_id
where bd.payment_status in ('y', 'p')
and bh.hospital_id = $P{hospital_id}
and bh.billing_date >= $P{from_date}
and bh.billing_date <= $P{to_date}   
group by mh.hospital_name, msc.service_cat_name;]]>
	</queryString>
