<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="opd_billing_register" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="NoDataSection" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="ba7c559a-2b83-432e-9a60-94e10333b2e4">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="hims_db_uat"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="path" class="java.lang.String">
		<defaultValueExpression><![CDATA["/Users/rozaltheric/Downloads/arigen_health.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="hospital_id" class="java.lang.Long"/>
	<parameter name="sub_chargecode_id" class="java.lang.Long"/>
	<parameter name="from_date" class="java.util.Date">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="to_date" class="java.util.Date">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select distinct
	mh.hospital_name,
	msc.service_cat_name,
	bh.bill_no,
	bh.bill_date,
	concat(p.p_fn, ' ', coalesce(p.p_mn, ''), ' ', p.p_ln) as patient_name,
	case v.visit_type
		when 'N' then 'New'
		else 'Follow up'
	end as visit_type,
	bh.total_amount,
	bh.discount_amount,
	bh.tax_total,
	bh.net_amount,
	pd.payment_mode,
	mscc.sub_chargecode_name
from billing_header bh
left join patient p on bh.patient_id = p.patient_id
left join visit v on bh.visit_id = v.visit_id
left join payment_details pd on bh.bill_hd_id = pd.billing_hd_id
left join mas_hospital mh on bh.hospital_id = mh.hospital_id
left join mas_service_category msc on bh.service_category_id = msc.id
left join rad_orderdt rod on bh.rad_order_hd_id = rod.rad_orderhd_id
left join mas_sub_chargecode mscc on rod.sub_chargecode_id = mscc.sub_chargecode_id
where bh.payment_status in('y', 'p')
and bh.service_category_id = 4
and bh.hospital_id = $P{hospital_id}
and (rod.sub_chargecode_id = $P{sub_chargecode_id} or $P{sub_chargecode_id} = 0)
and bh.billing_date between $P{from_date} and $P{to_date}]]>
	</queryString>
