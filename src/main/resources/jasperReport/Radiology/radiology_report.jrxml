<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="radiology_report" pageWidth="595" pageHeight="842" whenNoDataType="NoDataSection" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="dc46afb7-39ed-4d83-824c-9e2895af52bb">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="hims_db_uat"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="path" class="java.lang.String">
		<defaultValueExpression><![CDATA["/Users/rozaltheric/Downloads/arigen_health.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="rad_orderdt_id" class="java.lang.Long"/>
	<queryString>
		<![CDATA[select 
	mh.hospital_name,
	p.uhid_no as patient_id,
	concat(p.p_fn, ' ', p.p_ln) as patient_name,
	concat(p.p_age, '/', mg.gender_name) as age_gender,
	to_char(hd.order_time, 'dd/MM/yyyy hh12:mi am') as order_date_time,
	to_char(dt.study_date, 'dd/MM/yyyy hh12:mi am') as study_date_time,
	to_char(dt.report_date, 'dd/MM/yyyy hh12:mi am') as report_date_time,
	dmi.investigation_name,
	replace(
		replace(
			replace(
				replace(
					rsr.report_desc,'<h3><strong>','<b>'
				),'</strong></h3>','</b><br/><br/>'
			),'<p>',''
		),'</p>','<br/><br/>'
	) as description,
	concat(me.emp_fn, ' ', coalesce(me.emp_mn, ''), ' ',me.emp_ln) as doc_name,
	me.qualification,
	me.medical_registration_no
from rad_orderdt dt
left join rad_study_report rsr on dt.rad_orderdt_id = rsr.rad_orderdt_id
left join users u on rsr.createdby = u.user_id
left join mas_employee me on u.employee_id = me.emp_id
left join rad_orderhd hd on dt.rad_orderhd_id = hd.rad_orderhd_id
left join dg_mas_investigation dmi on dt.investigation_id = dmi.investigation_id
left join patient p on hd.patient_id = p.patient_id
left join mas_gender mg on p.p_gender_id = mg.id
left join mas_hospital mh on hd.hospital_id = mh.hospital_id
where dt.report_status = 'y'
and dt.rad_orderdt_id = $P{rad_orderdt_id}]]>
	</queryString>
