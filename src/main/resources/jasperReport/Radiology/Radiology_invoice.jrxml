	<parameter name="Bill_header_id" class="java.lang.Integer"/>
	<parameter name="Pay_status" class="java.lang.String" isForPrompting="false"/>
	<parameter name="path" class="java.lang.String">
		<defaultValueExpression><![CDATA["/Users/rozaltheric/Downloads/arigen_health.png"]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[select
	bh.bill_hd_id,
    bh.bill_no as invoice_no,
    bh.hospital_name,
    mh.email as hospital_email,
    bh.hospital_address as registered_loc,
    case bh.patient_gender
        when 'Male' then concat('Mr.', bh.patient_display_name)
        when 'Female' then concat('Ms/Mrs.', bh.patient_display_name)
    end as patient_name,
    p.uhid_no as patient_id,
    bh.patient_age,
    bh.patient_gender,
    p.p_mobile_number as patient_contact,
    mh.gstn_no,
    coalesce(bp.payment_method, 'Cash') as payment_method,
    coalesce(bh.referred_by, 'self') as referred_by,
    msc.sac_code,
    bh.total_amount as order_value,
    bh.discount_amount,
    bh.tax_total as tax_amount,
    bh.net_amount as total_amount_value,
    coalesce(bh.total_paid, 0) as paid_amount,
    num_to_words(bh.total_paid) as amount_in_words,
    (bh.net_amount - coalesce(bh.total_paid, 0)) as balance_amount,
    case
        when bd.investigation_id is not null then concat('I', bd.investigation_id)
        when bd.package_id is not null then concat('P', bd.package_id)
    end as test_code,
    bd.item_name as test_name,
    case
        when bd.investigation_id is null then dip.actual_cost
        else ipd.price
    end as price,
    bh.payment_status,
    (rod.appointment_date + (dmi.report_ready_days * interval '1 day')) as estimated_report_by,
    rod.lab_ids as lab_id,
    rod.lab_order_date,
    bh.patient_address,
    bh.billing_date as bill_date,
    rod.appointment_date,
    bh.created_by
from billing_details bd
join billing_header bh on bd.bill_hd_id = bh.bill_hd_id
left join mas_hospital mh on bh.hospital_id = mh.hospital_id
left join patient p on bh.patient_id = p.patient_id
left join billing_payments bp on bh.bill_hd_id = bp.billing_hd_id
left join mas_service_category msc on bh.service_category_id = msc.id
left join dg_investigation_package dip on bd.package_id = dip.id
left join investigation_price_details ipd on bd.investigation_id = ipd.investigation_id
left join dg_mas_investigation dmi on bd.investigation_id = dmi.investigation_id
left join dg_orderhd doh on bh.hdorder_id = doh.orderhd_id
left join (
    select 
        rad_orderhd_id,
        max(order_accession_no) as lab_ids,
        max(createdon) as lab_order_date,
		appointment_date
    from rad_orderdt
	group by rad_orderhd_id, appointment_date
) rod on bh.rad_order_hd_id = rod.rad_orderhd_id
where bd.payment_status = 'y'
and bh.service_category_id = 4
and bh.bill_hd_id = $P{Bill_header_id}]]>
	</queryString>
