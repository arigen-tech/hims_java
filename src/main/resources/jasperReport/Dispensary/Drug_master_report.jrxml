<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Drug_master_report" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="b98fb5c8-19b1-4d50-8022-e5cc4c89efa1">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="hims_dev_db"/>
	<parameter name="path" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT
    msi.pvms_no AS code,
    msi.nomenclature,
    mic.item_class_name AS class,
    micat.item_category_name AS category,
    inventory_unit.unit_name AS inventory_unit,
    dispensing_unit.unit_name AS dispensing_unit,
    msi.hsn_code,
    msi.drug_schedule,
    CASE
        WHEN UPPER(TRIM(msi.available_in_opd)) = 'Y' THEN 'Yes'
        ELSE 'No'
    END AS opd,
    CASE
        WHEN UPPER(TRIM(msi.available_in_ipd)) = 'Y' THEN 'Yes'
        ELSE 'No'
    END AS ipd,
    CASE
        WHEN UPPER(TRIM(msi.available_in_emergency)) = 'Y' THEN 'Yes'
        ELSE 'No'
    END AS emergency,
    CASE
        WHEN UPPER(TRIM(msi.available_in_ot)) = 'Y' THEN 'Yes'
        ELSE 'No'
    END AS ot,
    msi.store_rol,
    CASE
        WHEN UPPER(TRIM(msi.status)) = 'Y' THEN 'Active'
        ELSE 'Inactive'
    END AS status,
	mh.hospital_name
FROM mas_store_item msi
LEFT JOIN mas_item_class mic ON mic.item_class_id = msi.item_class_id
LEFT JOIN mas_item_category micat ON micat.item_category_id = msi.item_category_id
LEFT JOIN mas_store_unit inventory_unit ON inventory_unit.unit_id = msi.unit_au
LEFT JOIN mas_store_unit dispensing_unit ON dispensing_unit.unit_id = msi.dispensing_unit
left join mas_hospital mh on msi.hospital_id = mh.hospital_id ]]>
	</queryString>
