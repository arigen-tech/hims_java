<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="nis_slip_report" pageWidth="595" pageHeight="842" whenNoDataType="NoPages" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" isFloatColumnFooter="true" uuid="85889650-2459-4333-bdeb-93f7589b8f20">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="103"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="887"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="hims_db"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="visitId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="path" class="java.lang.String" isForPrompting="false"/>
	<parameter name="hospitalId" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT
    p.uhid_no AS patient_service_no,
    CONCAT_WS(' ', p.p_fn, p.p_mn, p.p_ln) AS patient_name,
    p.p_mobile_number AS mobileNumber,
    pph.hospital_id AS hospitalId,
    hos.hospital_name AS hospital_name,
    CONCAT_WS(' ', u.first_name, u.middle_name, u.last_name) AS doctor,
    item.nomenclature AS Particulars,
    item.pvms_no,
    ppd.total AS Qty,
    COALESCE(ppd.issued_qty, 0) AS issued,
    pph.prescription_number AS slip_no,
    pph.nis_no AS nisNo,
    pph.issued_by AS Pharmatiest,
    pph.issued_date AS issued_date
FROM patient_prescription_dt ppd
INNER JOIN patient_prescription_hd pph
    ON ppd.prescription_hd_id = pph.prescription_hd_id
LEFT JOIN patient p
    ON pph.patient_id = p.patient_id
LEFT JOIN visit v
    ON pph.visit_id = v.visit_id
LEFT JOIN users u
    ON v.doctor_id = u.user_id
LEFT JOIN mas_store_item item
    ON item.item_id = ppd.item_id
LEFT JOIN mas_hospital hos
    ON pph.hospital_id = hos.hospital_id
WHERE pph.status = 'y'
  AND pph.visit_id = $P{visitId}
  AND pph.hospital_id = $P{hospitalId}
  AND ppd.total > COALESCE(ppd.issued_qty, 0)
  AND pph.nis_no IS NOT NULL
GROUP BY
    p.uhid_no,
    p.p_mobile_number,
    CONCAT_WS(' ', p.p_fn, p.p_mn, p.p_ln),
    pph.hospital_id,
    hos.hospital_name,
    CONCAT_WS(' ', u.first_name, u.middle_name, u.last_name),
    item.nomenclature,
    item.pvms_no,
    ppd.total,
    pph.nis_no,
    pph.issued_by,
    pph.issued_date,
    ppd.issued_qty,
    pph.prescription_number;]]>
	</queryString>
