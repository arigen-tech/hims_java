	<parameter name="path" class="java.lang.String">
		<defaultValueExpression><![CDATA["/Users/rozaltheric/Downloads/arigen_health.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="from_date" class="java.util.Date">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="to_date" class="java.util.Date">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="indent_type" class="java.lang.String"/>
	<parameter name="department_id" class="java.lang.Long"/>
	<parameter name="hospital_id" class="java.lang.Long"/>
	<queryString>
		<![CDATA[select distinct
	mh.hospital_name,
	msi.nomenclature,
	msi.item_id as item_code,
	siim.indent_no,
	to_char(siim.indent_date, 'dd/MM/yyyy') as indent_date,
	dt.batch_no,
	to_char(dt.expiry_date, 'dd/MM/yyyy') as  expiry_date,
	dt.brand_name,
	dt.manufacturer_name,
	cast(siit.requested_qty as bigint) as requested_qty,
	cast(dt.issued_qty as bigint) as issued_qty,
	cast(dt.received_qty as bigint) as received_qty,
	cast(dt.rejected_qty as bigint) as rejected_qty,
	to_char(hd.received_date, 'dd/MM/yyyy') as received_date,
	dt.rejection_reason,
	md.department_name as to_department,
	md1.department_name as from_department,
	hd.received_by,
	case siim.indent_type_drug_or_nondrug
		when 'D' then 'Drug'
		when 'N' then 'Non Drug'
	end as indent_type
from store_indent_receive_t dt
left join store_indent_receive_m hd on dt.receive_m_id = hd.receive_m_id
left join store_internal_indent_m siim on hd.indent_m_id = siim.indent_m_id
left join store_issue_m sim on siim.store_issue_m_id = sim.store_issue_m_id
left join store_internal_indent_t siit on dt.indent_t_id = siit.indent_t_id
left join mas_department md on hd.received_dept_id = md.department_id
left join mas_department md1 on hd.store_id = md1.department_id
left join mas_store_item msi on dt.item_id = msi.item_id
left join mas_hospital mh on msi.hospital_id = mh.hospital_id
where hd.received_date between $P{from_date} and $P{to_date}
and sim.hospital_id = $P{hospital_id}
and hd.received_dept_id = $P{department_id}
and siim.indent_type_drug_or_nondrug = $P{indent_type}]]>
	</queryString>
