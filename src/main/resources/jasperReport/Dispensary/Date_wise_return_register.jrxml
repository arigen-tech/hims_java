	<parameter name="from_date" class="java.util.Date">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="to_date" class="java.util.Date">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="path" class="java.lang.String">
		<defaultValueExpression><![CDATA["/Users/rozaltheric/Downloads/arigen_health.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="hospital_id" class="java.lang.Long"/>
	<parameter name="department_id" class="java.lang.Long"/>
	<parameter name="indent_type" class="java.lang.String"/>
	<queryString>
		<![CDATA[select distinct
	hd.return_m_id,
	mh.hospital_name,
	md.department_name,
	siim.indent_no,
	to_char(siim.indent_date, 'dd/MM/yyyy') as indent_date,
	md1.department_name as return_to_department,
	to_char(hd.return_date, 'dd/MM/yyyy') as return_date,
	hd.return_no,
	dt.item_id,
	msi.nomenclature,
	dt.batch_no,
	to_char(dt.expiry_date, 'dd/MM/yyyy') as doe,
	concat(dt.brand_name, ' / ', dt.manufacturer_name) as brand_manufacturer,
	cast(sirt.issued_qty as bigint) as issued_qty,
	cast(sirt.received_qty as bigint) as received_qty,
	cast(sirt.rejected_qty as bigint) as returned_qty,
	hd.remarks,
	case siim.indent_type_drug_or_nondrug
		when 'D' then 'Drug'
		when 'N' then 'Non Drug'
	end as indent_type
from store_return_t dt
left join store_return_m hd on dt.return_m_id = hd.return_m_id
left join store_indent_receive_t sirt on dt.receive_t_id = sirt.receive_t_id
left join store_indent_receive_m sirm on hd.receive_m_id = sirm.receive_m_id
left join store_internal_indent_m siim on sirm.indent_m_id = siim.indent_m_id
left join store_issue_m sim on siim.store_issue_m_id = sim.store_issue_m_id
left join mas_department md on sirm.received_dept_id = md.department_id
left join mas_department md1 on hd.store_id = md1.department_id
left join mas_store_item msi on dt.item_id = msi.item_id
left join mas_hospital mh on sim.hospital_id = mh.hospital_id
where sim.hospital_id = $P{hospital_id}
and sirm.received_dept_id = $P{department_id}
and hd.return_date between $P{from_date} and $P{to_date}
and siim.indent_type_drug_or_nondrug = $P{indent_type}]]>
	</queryString>
