	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="path" class="java.lang.String" isForPrompting="false"/>
	<parameter name="fromDate" class="java.util.Date">
		<defaultValueExpression><![CDATA[new java.util.Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="toDate" class="java.util.Date">
		<defaultValueExpression><![CDATA[new java.util.Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="hospitalId" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT 
    mh.hospital_name AS hospital_name,
    item.nomenclature AS particulars,
    item.pvms_no AS item_code,
    SUM(ppd.total) AS total,
    SUM(COALESCE(ppd.issued_qty, 0)) AS issued
FROM patient_prescription_dt ppd

LEFT OUTER JOIN patient_prescription_hd pph 
    ON ppd.prescription_hd_id = pph.prescription_hd_id

LEFT OUTER JOIN mas_store_item item 
    ON item.item_id = ppd.item_id

LEFT OUTER JOIN mas_hospital mh
    ON mh.hospital_id = pph.hospital_id

WHERE pph.prescription_date BETWEEN $P{fromDate} AND $P{toDate}
  AND pph.hospital_id = $P{hospitalId}
  AND (pph.status = 'y' OR pph.status = 'Y')
  AND ppd.total > ppd.issued_qty
  AND pph.nis_no IS NOT NULL

GROUP BY 
    mh.hospital_name,
    item.nomenclature,
    item.pvms_no

ORDER BY item.nomenclature;]]>
	</queryString>
