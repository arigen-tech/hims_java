<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="nursing_assessment" pageWidth="595" pageHeight="842" columnWidth="595" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="8f0f57e5-0c9f-4555-afc8-c37eb8836ed1">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="hims_dev_db"/>
	<property name="com.jaspersoft.studio.unit." value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageHeight" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageWidth" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.topMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.bottomMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.leftMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.rightMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.columnWidth" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.columnSpacing" value="pixel"/>
	<parameter name="assessmentId" class="java.lang.Integer"/>
	<queryString language="SQL">
		<![CDATA[SELECT
    COALESCE(
        NULLIF(TRIM(inma.chief_complaint), ''),
        '-'
    ) AS chief_complaint,
    COALESCE(
        NULLIF(TRIM(inma.history_present_illness), ''),
        '-'
    ) AS history_present_illness,
    COALESCE(
        NULLIF(TRIM(inma.family_history), ''),
        '-'
    ) AS family_history,
    COALESCE(
        NULLIF(TRIM(inma.medication_history), ''),
        '-'
    ) AS medication_history,
    COALESCE(
        NULLIF(TRIM(inma.allergies), ''),
        '-'
    ) AS allergies,
    COALESCE(
        inma.pulse::text,
        '-'
    ) AS pulse,
    CASE
        WHEN inma.systolic_bp IS NULL
             AND inma.diastolic_bp IS NULL
            THEN '-'
        ELSE CONCAT(
            COALESCE(inma.systolic_bp::text, '-'),
            '/',
            COALESCE(inma.diastolic_bp::text, '-')
        )
    END AS bp,
    CASE
        WHEN inma.temperature IS NULL
            THEN '-'
        ELSE CONCAT(
            inma.temperature::text,
            CASE
                WHEN NULLIF(TRIM(inma.temperature_unit), '') IS NOT NULL
                    THEN ' ' || TRIM(inma.temperature_unit)
                ELSE ''
            END
        )
    END AS temperature,
    COALESCE(
        inma.respiratory_rate::text,
        '-'
    ) AS respiratory_rate,
    COALESCE(
        inma.spo2::text,
        '-'
    ) AS spo2,
    COALESCE(
        NULLIF(TRIM(inma.general_examination_notes), ''),
        '-'
    ) AS general_examination_notes,
    COALESCE(
        NULLIF(TRIM(inma.system_rs_examination), ''),
        '-'
    ) AS respiratory_system,
    COALESCE(
        NULLIF(TRIM(inma.system_cvs_examination), ''),
        '-'
    ) AS cardiovascular_system,
    COALESCE(
        NULLIF(TRIM(inma.system_pa_examination), ''),
        '-'
    ) AS abdomen,
    COALESCE(
        NULLIF(TRIM(inma.system_cns_examination), ''),
        '-'
    ) AS central_nervous_system,
    COALESCE(
        NULLIF(TRIM(inma.provisional_diagnosis), ''),
        '-'
    ) AS provisional_diagnosis,
    COALESCE(
        NULLIF(TRIM(inma.created_by), ''),
        '-'
    ) AS prepared_by,
    COALESCE(
        NULLIF(TRIM(inma.updated_by), ''),
        '-'
    ) AS reviewed_by
FROM ip_nursing_medical_assessment inma
WHERE inma.assessment_id = $P{assessmentId};]]>
	</queryString>
