	<parameter name="assessmentId" class="java.lang.Integer"/>
	<queryString language="SQL">
		<![CDATA[SELECT
    COALESCE(NULLIF(TRIM(inma.consciousness), ''), '-') AS consciousness,
    COALESCE(inma.gcs_score::text, '-') AS gcs_score,
    COALESCE(inma.pain_score::text, '-') AS pain_score,
    COALESCE(NULLIF(TRIM(inma.mobility_status), ''), '-') AS mobility_status,
    COALESCE(NULLIF(TRIM(inma.fall_risk), ''), '-') AS fall_risk,
    COALESCE(NULLIF(TRIM(inma.pressure_sore_risk), ''), '-') AS pressure_sore_risk,
    COALESCE(NULLIF(TRIM(inma.skin_condition), ''), '-') AS skin_condition,
    CASE inma.iv_line_present
        WHEN 'Y' THEN 'Yes'
        WHEN 'N' THEN 'No'
        ELSE '-'
    END AS iv_line_present,
    COALESCE(NULLIF(TRIM(inma.iv_site), ''), '-') AS iv_site,
    CASE inma.drain_present
        WHEN 'Y' THEN 'Yes'
        WHEN 'N' THEN 'No'
        ELSE '-'
    END AS drain_present,
    COALESCE(NULLIF(TRIM(inma.drain_type), ''), '-') AS drain_type,
    CASE inma.catheter_present
        WHEN 'Y' THEN 'Yes'
        WHEN 'N' THEN 'No'
        ELSE '-'
    END AS catheter_present,
    COALESCE(NULLIF(TRIM(inma.catheter_type), ''), '-') AS catheter_type,
    COALESCE(NULLIF(TRIM(inma.nutrition_risk), ''), '-') AS nutrition_risk,
    COALESCE(NULLIF(TRIM(inma.infection_risk), ''), '-') AS infection_risk,
    CASE inma.patient_orientation_done
        WHEN 'Y' THEN 'Yes'
        WHEN 'N' THEN 'No'
        ELSE '-'
    END AS patient_orientation,
    CASE inma.relative_orientation_done
        WHEN 'Y' THEN 'Yes'
        WHEN 'N' THEN 'No'
        ELSE '-'
    END AS relative_orientation,
    COALESCE(NULLIF(TRIM(inma.nursing_care_plan), ''), '-') AS nursing_care_plan
FROM ip_nursing_medical_assessment inma
WHERE inma.assessment_id = $P{assessmentId};  ]]>
	</queryString>
