<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Patient_details" pageWidth="550" pageHeight="842" columnWidth="550" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="6b917bda-c067-4a50-b94b-a72345a07b35">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="hims_dev_db"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="inPatientId" class="java.lang.Integer"/>
	<parameter name="path" class="java.lang.String">
		<defaultValueExpression><![CDATA["/Users/rozaltheric/Downloads/arigen_health.png"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    CONCAT( p.p_fn, ' ', COALESCE(p.p_mn || ' ', ''), p.p_ln) AS patient_name,
    SPLIT_PART(p.p_age, 'Y', 1)::INT AS p_age,
    mg.gender_code,
    ip.inpatient_id,
    ip.admission_no,
    p.uhid_no,
    p.p_mobile_number,
    concat(me.emp_fn, ' ', me.emp_ln) AS doctor_name,
    mb.bed_number,

    TO_CHAR(iba.allocation_start_date, 'DD/MM/YYYY') AS allocation_date,
    COALESCE(ide.diagnosis_text, ip.initial_diagnosis,ip.icd ) AS diagnosis_text
FROM inpatient ip
LEFT JOIN patient p ON p.patient_id = ip.patient
LEFT JOIN mas_gender mg ON mg.id = p.p_gender_id
LEFT JOIN (
    SELECT DISTINCT ON (ip_admission_id)
        ip_admission_id,
        bed_id,
        allocation_start_date
    FROM ip_bed_allocation
    ORDER BY
        ip_admission_id,
        allocation_start_date DESC
) iba
    ON iba.ip_admission_id = ip.inpatient_id
LEFT JOIN mas_bed mb ON mb.bed_id = COALESCE(iba.bed_id, ip.bed_id)
LEFT JOIN (
    SELECT DISTINCT ON (inpatient_id)
        inpatient_id,
        diagnosis_text,
        diagnosis_datetime,
        recorded_by
    FROM ip_diagnosis_entry
    ORDER BY
        inpatient_id,
        diagnosis_datetime DESC
) ide
    ON ide.inpatient_id = ip.inpatient_id
inner join users u on ide.recorded_by = u.user_id
inner join mas_employee me on u.employee_id = me.emp_id
WHERE ip.inpatient_id = $P{inPatientId}]]>
	</queryString>
