	<parameter name="inPatientId" class="java.lang.Integer"/>
	<queryString language="SQL">
		<![CDATA[select 
	idcse.visit_datetime,
	idcse.doctor_name,
	md.department_name ,
	idcse.doctor_notes,
	idcse.investigation_summary ,
	idcse. medicine_summary ,
	idcse.care_plan_changes,
	mvt.visit_type_name
from ip_daily_case_sheet_entry idcse
left join mas_department md on idcse.visit_department_id  = md.department_id
left join mas_visit_type mvt on idcse.visit_type_id = mvt.visit_type_id 
where idcse.inpatient_id = $P{inPatientId}]]>
	</queryString>
