	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="inPatientId" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[select
	iv.inpatient_id,
    to_char(iv.observation_datetime, 'DD/MM/YYYY HH12:MI AM') as observation_datetime,
    CONCAT(iv.bp_systolic, '/', iv.bp_diastolic) AS bp,
    iv.temperature,
    iv.pulse,
    iv.respiration,
    iv.spo2,
    iv.pain_score,
    coalesce(iv.notes, 'NA') AS remarks,
    iv.last_updated_by AS taken_by,

    CONCAT(
        ROUND(AVG(iv.bp_systolic) OVER (), 0),
        '/',
        ROUND(AVG(iv.bp_diastolic) OVER (), 0)
    ) AS avg_bp,

    ROUND(MAX(iv.temperature) OVER (), 1) AS max_temperature,
    ROUND(MAX(iv.pulse) OVER (), 0) AS max_pulse,
    ROUND(MIN(iv.respiration) OVER (), 0) AS min_respiration,
    ROUND(MIN(iv.spo2) OVER (), 0) AS min_spo2
FROM ip_vitals iv
where iv.inpatient_id = $P{inPatientId}]]>
	</queryString>
