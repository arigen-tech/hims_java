	<subDataset name="ipInvestigationSummary" uuid="1075ef0c-95f1-426c-a7d6-ff0b6256f8d4">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="hims_dev_db"/>
		<parameter name="inPatientId" class="java.lang.Integer"/>
		<queryString language="SQL">
			<![CDATA[WITH investigation_status AS
(
    SELECT
        hd.orderhd_id,

        CASE
            WHEN LOWER(COALESCE(dred.validated, 'n')) = 'y'
                THEN TRUE
            ELSE FALSE
        END AS is_completed

    FROM dg_result_entry_header dreh

    INNER JOIN dg_orderhd hd
        ON hd.orderhd_id = dreh.order_hd_id

    INNER JOIN dg_result_entry_detail dred
        ON dred.result_entry_id = dreh.result_entry_id

    WHERE dreh.inpatient_id = $P{inPatientId}
),

order_status AS
(
    SELECT
        orderhd_id,

        BOOL_AND(is_completed) AS fully_completed

    FROM investigation_status

    GROUP BY orderhd_id
)

SELECT
    COUNT(*) AS total_orders,

    COUNT(*) FILTER (
        WHERE fully_completed = TRUE
    ) AS completed_orders,

    COUNT(*) FILTER (
        WHERE fully_completed = FALSE
    ) AS pending_orders

FROM order_status;]]>
		</queryString>
		<field name="total_orders" class="java.lang.Long">
			<property name="com.jaspersoft.studio.field.name" value="total_orders"/>
			<property name="com.jaspersoft.studio.field.label" value="total_orders"/>
		</field>
		<field name="completed_orders" class="java.lang.Long">
			<property name="com.jaspersoft.studio.field.name" value="completed_orders"/>
			<property name="com.jaspersoft.studio.field.label" value="completed_orders"/>
		</field>
		<field name="pending_orders" class="java.lang.Long">
			<property name="com.jaspersoft.studio.field.name" value="pending_orders"/>
			<property name="com.jaspersoft.studio.field.label" value="pending_orders"/>
		</field>
	</subDataset>
	<parameter name="inPatientId" class="java.lang.Integer"/>
	<queryString language="SQL">
		<![CDATA[SELECT
    COALESCE(
        hd.order_time,
        hd.order_date::timestamp
    ) AS order_datetime,
    CASE (dred.result_type)
        WHEN 's' THEN 'Single'
        WHEN 'm' THEN 'Multiple'
        ELSE 'Template'
    END AS result_type,
    dmi.investigation_name AS test_name,
    CASE
        WHEN LOWER(COALESCE(dred.validated, 'n')) = 'y'
            THEN 'Completed'

        WHEN COALESCE(
            dscd.collection_time,
            dsch.collection_time
        ) IS NOT NULL
            THEN 'Collected'

        ELSE 'Pending'
    END AS status,
 	dred.result,
    COALESCE(
        dscd.collection_time,
        dsch.collection_time
    ) AS collected_on,
    CASE
        WHEN dsch.validation_date IS NOT NULL
        THEN
            dsch.validation_date
            + COALESCE(
                dsch.validation_time,
                TIME '00:00:00'
            )
        ELSE NULL
    END AS completed_on,
    hd.createdby AS ordered_by,
    concat(me.emp_fn, ' ', me.emp_ln) as doctor_name
FROM dg_result_entry_header dreh
INNER JOIN dg_orderhd hd
    ON hd.orderhd_id = dreh.order_hd_id
INNER JOIN dg_result_entry_detail dred
    ON dred.result_entry_id = dreh.result_entry_id
INNER JOIN dg_mas_investigation dmi
    ON dmi.investigation_id = dred.investigation_id
LEFT JOIN dg_sample_collection_details dscd
    ON dscd.sample_collection_details_id =
       dred.sample_collection_details_id
   AND dscd.investigation_id =
       dred.investigation_id
LEFT JOIN dg_sample_collection_header dsch
    ON dsch.sample_collection_header_id =
       COALESCE(
           dscd.sample_collection_header_id,
           dreh.sample_collection_header_id
       )
left join users u on hd.prescribed_by = u.user_id
left join mas_employee me on u.employee_id = me.emp_id
WHERE dreh.inpatient_id = $P{inPatientId}]]>
	</queryString>
