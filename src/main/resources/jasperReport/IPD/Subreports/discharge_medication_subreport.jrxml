	<parameter name="inPatientId" class="java.lang.Integer"/>
	<queryString language="SQL">
		<![CDATA[select 
	idm.medicine_name,
	idm.dosage ,
	idm.frequency,
	coalesce(concat(idm.duration_days, ' Days'), null) as duration_days,
	idm.total_doses ,
	idm.route ,
	idm.instruction 
from ip_discharge_medication idm 
where idm.inpatient_id = $P{inPatientId}]]>
	</queryString>
