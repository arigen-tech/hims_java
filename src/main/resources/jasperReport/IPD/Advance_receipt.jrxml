	<parameter name="receiptId" class="java.lang.Integer"/>
	<parameter name="path" class="java.lang.String">
		<defaultValueExpression><![CDATA["/Users/rozaltheric/Downloads/arigen_health.png"]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT
    rh.receipt_id,
    rh.receipt_no,
    rh.receipt_date,
    rh.inpatient_id,
    COALESCE( ip.admission_no, ip.inpatient_id::TEXT) AS ip_no,
    p.uhid_no AS patient_id,
    CONCAT(p.p_fn, ' ', COALESCE(p.p_mn || ' ', ''), p.p_ln) AS patient_name,
    ip.admission_date + COALESCE(ip.admission_time, TIME '00:00:00') AS admit_date_time,
    mb.bed_number,
    ip.consent_taken_by AS doctor_name,
    concat(p.p_address1, ' , ', p.p_address2, ' , ', p.p_city, ' , ', p.p_pincode) AS patient_address,
    mh.gstn_no AS gstin_no,
    COALESCE(
        mrt.receipt_type_name,
        'Deposit/Advance'
    ) AS recipt_type,
    mpm.mode_name AS mode_of_payment,
    rd.amount,
    rh.total_amount,
    rh.remarks AS receipt_remarks,
    msc.service_cat_name,
    msc.sac_code,
    num_to_words(rh.total_amount) as total_amount_words,
    rh.last_chg_by
FROM ipd_bl_receipt_hd rh
INNER JOIN inpatient ip ON ip.inpatient_id = rh.inpatient_id
LEFT JOIN patient p ON p.patient_id = ip.patient
LEFT JOIN mas_bed mb ON mb.bed_id = ip.bed_id
LEFT JOIN mas_receipt_type mrt ON mrt.receipt_type_id = rh.receipt_type_id
LEFT JOIN ipd_bl_receipt_dt rd ON rd.receipt_id = rh.receipt_id
LEFT JOIN mas_payment_mode mpm ON mpm.payment_mode_id = rd.payment_mode_id
left join mas_hospital mh on p.p_hospital_id = mh.hospital_id 
left join mas_service_category msc on rh.service_category_id = msc.id
WHERE rh.receipt_id = $P{receiptId}]]>
	</queryString>
