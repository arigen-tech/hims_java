<?xml version="1.0" encoding="UTF-8"?>
<!-- Created with Jaspersoft Studio version 6.21.5.final using JasperReports Library version 6.20.1  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="IPD_summary_bill" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="00ba3de7-c717-4902-a6b0-d477028690d0">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="hims_dev_db"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="inpatientId" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT
    bh.bill_id,
    i.admission_no AS ipno,
    bh.uhid AS patient_id,
    bh.patient_name,
    CONCAT(i.admission_no, ' ', i.admission_time) AS admission_date_time,
    CONCAT(p.p_address1, ' ', p.p_address2, ' ', p.p_city, ' ', p.p_pincode) AS patient_address,
    CONCAT(mw.ward_name, ' / ', mb.bed_number) AS ward_bed,
    bh.insurance_id,
    bh.tpa_id,
    bh.policy_no,
    bh.claim_no,
    TO_CHAR(bh.bill_date, 'DD/MM/YYYY HH12:MI AM') AS bill_date,
    bh.total_amount AS grand_price,
    bh.gst_amount AS grand_gst,
    bh.net_amount AS grand_amount,
    bh.credit_limit,
    bd.category_id,
    misc.category_name AS service_name,
    SUM(COALESCE(bd.net_amount, 0)) AS total_amount
FROM ipd_billing_header bh
LEFT JOIN ipd_billing_details bd ON bd.bill_id = bh.bill_id AND COALESCE(bd.is_cancelled, FALSE) = FALSE
LEFT JOIN inpatient i ON bh.inpatient_id = i.inpatient_id
LEFT JOIN patient p ON i.patient = p.patient_id
LEFT JOIN mas_ward mw ON i.admitting_ward_id = mw.ward_id
LEFT JOIN mas_bed mb ON i.bed_id = mb.bed_id
LEFT JOIN mas_ipd_service_category misc ON bd.category_id = misc.category_id
WHERE bh.inpatient_id = $P{inpatientId}
GROUP BY
    bh.bill_id,
    i.admission_no,
    i.admission_time,
    bh.uhid,
    bh.patient_name,
    p.p_address1,
    p.p_address2,
    p.p_city,
    p.p_pincode,
    mw.ward_name,
    mb.bed_number,
    bh.insurance_id,
    bh.tpa_id,
    bh.policy_no,
    bh.claim_no,
    bh.bill_date,
    bh.total_amount,
    bh.gst_amount,
    bh.net_amount,
    bh.credit_limit,
    bd.category_id,
    misc.category_name
ORDER BY bd.category_id]]>
	</queryString>
