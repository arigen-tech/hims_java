<?xml version="1.0" encoding="UTF-8"?>
<!-- Created with Jaspersoft Studio version 6.21.5.final using JasperReports Library version 6.20.1  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="admission_details" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="936fd2ab-a49f-4cd2-b25d-32ba6204227f">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="hims_dev_db"/>
	<parameter name="inPatientId" class="java.lang.Integer"/>
	<parameter name="path" class="java.lang.String">
		<defaultValueExpression><![CDATA["/Users/rozaltheric/Downloads/arigen_health.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA["/Users/rozaltheric/JaspersoftWorkspace/MyReports/Billing/IPD_reports/IPD_subreports/"]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT
    ds.discharge_id,
    ip.inpatient_id,
    COALESCE(ip.admission_no, ip.inpatient_id::TEXT) AS ip_no,

    CONCAT_WS(
        ' ',
        NULLIF(TRIM(p.p_fn), ''),
        NULLIF(TRIM(p.p_mn), ''),
        NULLIF(TRIM(p.p_ln), '')
    ) AS patient_name,

    p.uhid_no AS patient_id,

    CONCAT_WS(
        ' / ',
        NULLIF(TRIM(p.p_age), ''),
        NULLIF(TRIM(mg.gender_code), '')
    ) AS age_gender,

    ip.admission_date + ip.admission_time AS admit_date_time,

    COALESCE(
        ds.discharge_date,
        CASE
            WHEN ip.discharge_date IS NOT NULL
            THEN ip.discharge_date + COALESCE(ip.discharge_time, TIME '00:00:00')
        END
    ) AS discharge_date_time,
    
    ds.consultant_name AS consultant,

    CONCAT_WS(
        ' / ',
        NULLIF(TRIM(mw.ward_name), ''),
        NULLIF(TRIM(mb.bed_number), '')
    ) AS ward_bed,

    CONCAT_WS(
        E'\n',
        CASE
            WHEN NULLIF(TRIM(ds.primary_diagnosis), '') IS NOT NULL
            THEN 'Primary Diagnosis: ' || ds.primary_diagnosis
        END,
        CASE
            WHEN NULLIF(TRIM(ds.secondary_diagnosis), '') IS NOT NULL
            THEN 'Secondary Diagnosis: ' || ds.secondary_diagnosis
        END
    ) AS final_diagnosis,

    ds.presenting_complaints AS present_complaints,
    ds.history_of_illness AS history_of_present_illness,
    ds.past_history AS personal_past_history,
    ds.examination_findings AS on_examination,
    ds.procedure_details AS procedure_details,
    ds.hospital_course AS course_of_hospital_stay,

    mpdc.condition_name AS condition_on_discharge,

    ds.discharge_medications AS medication_on_discharge,
    ds.discharge_advice AS advice_on_discharge,
    ds.follow_up_advice AS follow_up_advice,
    ds.investigation_summary,
    ds.treatment_summary,
    ds.discharged_to,
    ds.referred_hospital_name,
    mdr.reason_name AS discharge_reason

FROM ip_discharge_summary ds

INNER JOIN inpatient ip
    ON ip.inpatient_id = ds.inpatient_id
LEFT JOIN patient p
    ON p.patient_id = ip.patient
LEFT JOIN mas_gender mg
    ON mg.id = p.p_gender_id
LEFT JOIN mas_patient_discharge_condition mpdc
    ON mpdc.condition_id = ds.condition_id
LEFT JOIN mas_discharge_reason mdr
    ON mdr.discharge_reason_id = ds.discharge_reason_id
LEFT JOIN mas_ward mw
    ON mw.ward_id = ip.admitting_ward_id
LEFT JOIN mas_bed mb
    ON mb.bed_id = ip.bed_id
WHERE ds.inpatient_id = $P{inPatientId}
ORDER BY ds.discharge_date DESC
LIMIT 1;]]>
	</queryString>
