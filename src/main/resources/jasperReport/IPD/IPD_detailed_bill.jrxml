<!-- Created with Jaspersoft Studio version 6.21.5.final using JasperReports Library version 6.20.1  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="IPD_detailed_bill" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="00ba3de7-c717-4902-a6b0-d477028690d0">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="hims_dev_db"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="inpatientId" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT
    bh.bill_id,
    i.admission_no  AS ipno,
    bh.uhid AS patient_id,
    bh.patient_name,
    concat(i.admission_no, ' ', i.admission_time ) as admission_date_time,
    concat(p.p_address1 , ' ', p.p_address2 , ' ', p.p_city , ' ', p.p_pincode ) as patient_address,
    concat(mw.ward_name, ' / ', mb.bed_number) as ward_bed,
    bh.insurance_id,
    bh.tpa_id,
    bh.policy_no,
    bh.claim_no,
    TO_CHAR(bh.bill_date, 'DD/MM/YYYY HH12:MI AM') AS bill_date,
    misc.category_name,
    bd.bill_item_id,
    CASE WHEN bd.category_id IN (3, 5) THEN CONCAT(bd.item_name, E'\n(Batch : ', COALESCE(bd.batch_no, ''), ' / DOE : ', COALESCE(TO_CHAR(bd.expiry_date, 'DD/MM/YY'), ''), ')') ELSE bd.item_name END AS item_name,
    TO_CHAR(bd.service_date, 'DD/MM/YYYY HH12:MI AM') AS service_date_time,
    COALESCE(bd.quantity, 0) AS quantity,
    COALESCE(bd.rate, 0) AS price,
    bd.gst_amount AS item_gst_amount,
    TO_CHAR(bd.gst_percent, 'FM999999990') || '%' AS gst_percent,
    COALESCE(bd.amount, 0) AS amount,
    COALESCE(bd.discount_amount, 0) AS item_discount_amount,
    COALESCE(bd.net_amount, 0) AS item_net_amount,
    bh.total_amount as grand_price,
    bh.gst_amount as grand_gst,
    bh.net_amount as grand_amount,
    bh.credit_limit 
FROM ipd_billing_header bh
LEFT JOIN ipd_billing_details bd ON bd.bill_id = bh.bill_id AND COALESCE(bd.is_cancelled, FALSE) = false
left join inpatient i on bh.inpatient_id = i.inpatient_id 
left join patient p on i.patient = p.patient_id 
left join mas_ward mw on i.admitting_ward_id = mw.ward_id 
left join mas_bed mb on i.bed_id = mb.bed_id 
left join mas_ipd_service_category misc on bd.category_id = misc.category_id 
WHERE bh.inpatient_id = $P{inpatientId}]]>
	</queryString>
