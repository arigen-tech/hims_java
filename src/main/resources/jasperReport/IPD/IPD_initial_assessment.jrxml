<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="IPD_initial_assessment" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="5ce9e8a8-bffa-402f-addc-61a8fcbe73be">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="hims_dev_db"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA["/Users/rozaltheric/JaspersoftWorkspace/MyReports/Billing/IPD_reports/IPD_subreports/"]]></defaultValueExpression>
	</parameter>
	<parameter name="assessmentId" class="java.lang.Integer"/>
	<parameter name="path" class="java.lang.String">
		<defaultValueExpression><![CDATA["/Users/rozaltheric/Downloads/arigen_health.png"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    nma.assessment_id,
    CONCAT(
        p.p_fn,
        ' ',
        COALESCE(p.p_mn || ' ', ''),
        COALESCE(p.p_ln, '')
    ) AS patient_name,

    p.uhid_no,
    CONCAT(
        SPLIT_PART(p.p_age, 'Y', 1),
        ' / ',
        COALESCE(mg.gender_code, '')
    ) AS age_gender,
    ip.admission_no AS ip_no,
    concat(mw.ward_name, ' / ', mb.bed_number) as ward_bed,
    md.department_name,
    nma.created_date as assessment_on,
    ip.consent_taken_by as doctor
FROM ip_nursing_medical_assessment nma
INNER JOIN inpatient ip ON ip.inpatient_id = nma.inpatient_id
INNER JOIN patient p ON p.patient_id = ip.patient
LEFT JOIN mas_gender mg ON mg.id = p.p_gender_id
left join mas_ward mw on ip.admitting_ward_id = mw.ward_id 
left join mas_bed mb on ip.bed_id = mb.bed_id 
left join mas_department md on mw.department_id = md.department_id
WHERE nma.assessment_id = $P{assessmentId}]]>
	</queryString>
