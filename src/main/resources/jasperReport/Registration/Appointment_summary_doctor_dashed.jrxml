	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="path" class="java.lang.String">
		<defaultValueExpression><![CDATA["/Users/rozaltheric/Downloads/arigen_health.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="hospital_id" class="java.lang.Long"/>
	<parameter name="from_date" class="java.util.Date">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="to_date" class="java.util.Date">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="department_id" class="java.lang.Long"/>
	<parameter name="doctor_id" class="java.lang.Long"/>
	<queryString>
		<![CDATA[select 
	h.hospital_name,
    v.doctor_name as doctor_name,
    count(v.visit_id) as total_count,
    count(case when lower(v.visit_status) = 'y' then 1 end) as completed_count,
    count(case when lower(v.visit_status) = 'c' then 1 end) as cancelled_count,
    count(case when lower(v.visit_status) = 'x' then 1 end) as no_show_count,
    count(case when lower(v.visit_status) = 'n' then 1 end) as pending_count
from visit v
left join mas_department d on d.department_id = v.department_id
left join mas_hospital h on v.hospital_id = h.hospital_id
where v.visit_type in ('F', 'N')
and v.hospital_id = $P{hospital_id}
and (v.department_id = $P{department_id} or $P{department_id} = 0)
and (v.doctor_id = $P{doctor_id} or $P{doctor_id} = 0)
and v.visit_date between $P{from_date} and $P{to_date}
group by h.hospital_name,v.doctor_name
order by v.doctor_name]]>
	</queryString>
