	<subDataset name="units" uuid="d14b49e4-1dbb-4b3c-887c-64246afa458e">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="hmis_db"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="sub_chargecode_id" class="java.lang.Long"/>
		<parameter name="investigation_id" class="java.lang.Long"/>
		<parameter name="sample_id" class="java.lang.Long"/>
		<parameter name="orderhd_id" class="java.lang.Integer"/>
		<queryString>
			<![CDATA[WITH selected_order AS (
    SELECT doh.patient_id
    FROM dg_orderhd doh
    WHERE doh.orderhd_id = $P{orderhd_id}
      AND EXISTS (
          SELECT 1
          FROM dg_orderdt dod
          WHERE dod.orderhd_id = doh.orderhd_id
            AND dod.investigation_id = $P{investigation_id}
      )
),
current_cutoff AS (
    SELECT MAX(dsch.collection_time) AS cutoff_ts
    FROM dg_result_entry_header dreh
    JOIN dg_result_entry_detail dred
        ON dred.result_entry_id = dreh.result_entry_id
    JOIN dg_sample_collection_details dscd
        ON dscd.sample_collection_details_id = dred.sample_collection_details_id
    JOIN dg_sample_collection_header dsch
        ON dsch.sample_collection_header_id = dscd.sample_collection_header_id
    JOIN dg_mas_investigation dmi
        ON dmi.investigation_id = dred.investigation_id
    WHERE dreh.order_hd_id = $P{orderhd_id}
      AND dred.validated = 'y'
      AND dred.investigation_id = $P{investigation_id}
      AND COALESCE(dscd.sample_id, dred.sample_id, dmi.sample_id)
            IS NOT DISTINCT FROM $P{sample_id}
),
history_rows AS (
    SELECT
        COALESCE(dsmi.sub_investigation_name, dmi.investigation_name)
            AS sub_investigation_name,
        mim.method_name,
        dsch.collection_time::date AS collection_date,
        dsch.collection_time::time AS collection_time,
        dsch.collection_time AS collection_ts,
        dred.result,
        du.uom_name AS unit
    FROM selected_order so
    JOIN dg_result_entry_header dreh
        ON dreh.hin_id = so.patient_id
    JOIN dg_result_entry_detail dred
        ON dred.result_entry_id = dreh.result_entry_id
    JOIN dg_sample_collection_details dscd
        ON dscd.sample_collection_details_id = dred.sample_collection_details_id
    JOIN dg_sample_collection_header dsch
        ON dsch.sample_collection_header_id = dscd.sample_collection_header_id
    JOIN dg_mas_investigation dmi
        ON dmi.investigation_id = dred.investigation_id
    LEFT JOIN dg_sub_mas_investigation dsmi
        ON dsmi.sub_investigation_id = dred.sub_investigation_id
    LEFT JOIN dg_uom du
        ON du.uom_id = dred.uom_id
    LEFT JOIN mas_investigation_methodology mim
        ON mim.method_id = dmi.method_id
    CROSS JOIN current_cutoff cc
    WHERE dred.validated = 'y'
      AND COALESCE(dreh.sub_chargecode_id, dmi.sub_chargecode_id)
            IS NOT DISTINCT FROM $P{sub_chargecode_id}
      AND dred.investigation_id = $P{investigation_id}
      AND COALESCE(dscd.sample_id, dred.sample_id, dmi.sample_id)
            IS NOT DISTINCT FROM $P{sample_id}
      AND cc.cutoff_ts IS NOT NULL
      AND dsch.collection_time <= cc.cutoff_ts
),
ranked_history AS (
    SELECT
        hr.*,
        DENSE_RANK() OVER (ORDER BY hr.collection_ts DESC) AS history_rank
    FROM history_rows hr
)
SELECT
    sub_investigation_name,
    method_name,
    collection_date,
    collection_time,
    collection_ts,
    result,
    unit
FROM ranked_history
WHERE history_rank <= 5
ORDER BY
    collection_ts DESC,
    sub_investigation_name]]>
		</queryString>
		<field name="sub_investigation_name" class="java.lang.String"/>
		<field name="method_name" class="java.lang.String"/>
		<field name="collection_date" class="java.sql.Date"/>
		<field name="collection_time" class="java.sql.Time"/>
		<field name="collection_ts" class="java.sql.Timestamp"/>
		<field name="result" class="java.lang.String"/>
		<field name="unit" class="java.lang.String"/>
	</subDataset>
	<subDataset name="unit_bioref" uuid="85d61754-5d16-4223-ad8b-175ac5ca8372">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="hmis_db"/>
		<parameter name="sub_chargecode_id" class="java.lang.Long"/>
		<parameter name="investigation_id" class="java.lang.Long"/>
		<parameter name="sample_id" class="java.lang.Long"/>
		<parameter name="orderhd_id" class="java.lang.Integer"/>
		<queryString language="SQL">
			<![CDATA[SELECT DISTINCT
    COALESCE(dsmi.sub_investigation_name, dmi.investigation_name)
        AS sub_investigation_name,
    du.uom_name AS unit,
    COALESCE(NULLIF(BTRIM(dred.normal_range), ''), '') AS bio_ref
FROM dg_result_entry_header dreh
JOIN dg_result_entry_detail dred
    ON dred.result_entry_id = dreh.result_entry_id
JOIN dg_sample_collection_details dscd
    ON dscd.sample_collection_details_id = dred.sample_collection_details_id
JOIN dg_mas_investigation dmi
    ON dmi.investigation_id = dred.investigation_id
LEFT JOIN dg_sub_mas_investigation dsmi
    ON dsmi.sub_investigation_id = dred.sub_investigation_id
LEFT JOIN dg_uom du
    ON du.uom_id = dred.uom_id
WHERE dreh.order_hd_id = $P{orderhd_id}
  AND dred.validated = 'y'
  AND COALESCE(dreh.sub_chargecode_id, dmi.sub_chargecode_id)
        IS NOT DISTINCT FROM $P{sub_chargecode_id}
  AND dred.investigation_id = $P{investigation_id}
  AND COALESCE(dscd.sample_id, dred.sample_id, dmi.sample_id)
        IS NOT DISTINCT FROM $P{sample_id}
  AND EXISTS (
      SELECT 1
      FROM dg_orderdt dod
      WHERE dod.orderhd_id = $P{orderhd_id}
        AND dod.investigation_id = dred.investigation_id
  )
ORDER BY sub_investigation_name]]>
		</queryString>
		<field name="sub_investigation_name" class="java.lang.String"/>
		<field name="unit" class="java.lang.String"/>
		<field name="bio_ref" class="java.lang.String"/>
	</subDataset>
	<parameter name="orderhd_id" class="java.lang.Integer"/>
	<parameter name="path" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[WITH current_order AS (
    SELECT
        doh.orderhd_id,
        doh.order_date,
        doh.order_no,
        doh.patient_id,
        doh.inpatient_id,
        CASE
            WHEN doh.inpatient_id IS NOT NULL THEN 'IPD'
            ELSE 'OPD'
        END AS order_type,
        COALESCE(ip.admission_no, doh.inpatient_id::text) AS admission_no,
        p.p_mobile_number AS mobile_no,
        p.uhid_no,
        CONCAT_WS(
            ' ',
            NULLIF(BTRIM(p.p_fn), ''),
            NULLIF(BTRIM(p.p_mn), ''),
            NULLIF(BTRIM(p.p_ln), '')
        ) AS patient_name,
        CONCAT_WS(
            '/',
            NULLIF(BTRIM(p.p_age), ''),
            NULLIF(BTRIM(mg.gender_code), '')
        ) AS age_gender,
        mr.relation_name AS ref_doctor,
        mh.address AS centre,
        COALESCE(
            bill.patient_address,
            NULLIF(
                CONCAT_WS(
                    ', ',
                    NULLIF(BTRIM(p.p_address1), ''),
                    NULLIF(BTRIM(p.p_address2), ''),
                    NULLIF(BTRIM(p.p_city), ''),
                    COALESCE(
                        NULLIF(BTRIM(p.p_pincode), ''),
                        NULLIF(BTRIM(p.pincode), '')
                    )
                ),
                ''
            ),
            'Not Available'
        ) AS patient_address,
        CASE
            WHEN doh.inpatient_id IS NOT NULL THEN
                CONCAT_WS(
                    ' / ',
                    COALESCE(ip.admission_no, doh.inpatient_id::text),
                    p.uhid_no
                )
            ELSE COALESCE(p.uhid_no, '')
        END AS patient_identifier
    FROM dg_orderhd doh
    JOIN patient p
        ON p.patient_id = doh.patient_id
    LEFT JOIN inpatient ip
        ON ip.inpatient_id = doh.inpatient_id
    LEFT JOIN mas_gender mg
        ON mg.id = p.p_gender_id
    LEFT JOIN mas_relation mr
        ON mr.relation_id = p.p_relation_id
    LEFT JOIN mas_hospital mh
        ON mh.hospital_id = doh.hospital_id
    LEFT JOIN LATERAL (
        SELECT NULLIF(BTRIM(bh.patient_address), '') AS patient_address
        FROM billing_header bh
        WHERE bh.hdorder_id = doh.orderhd_id
          AND NULLIF(BTRIM(bh.patient_address), '') IS NOT NULL
        ORDER BY bh.bill_hd_id DESC
        LIMIT 1
    ) bill ON TRUE
    WHERE doh.orderhd_id = $P{orderhd_id}
),
current_order_tests AS (
    SELECT DISTINCT dod.investigation_id
    FROM dg_orderdt dod
    WHERE dod.orderhd_id = $P{orderhd_id}
      AND dod.investigation_id IS NOT NULL
),
current_results AS (
    SELECT
        dreh.order_hd_id,
        dreh.result_date,
        dreh.result_time,
        COALESCE(dreh.sub_chargecode_id, dmi.sub_chargecode_id)
            AS sub_chargecode_id,
        dred.investigation_id,
        dred.sub_investigation_id,
        COALESCE(dscd.sample_id, dred.sample_id, dmi.sample_id) AS sample_id,
        dsch.collection_time,
        msc.sub_chargecode_name,
        dmi.investigation_name,
        dms.sample_description,
        COALESCE(dsmi.sub_investigation_name, dmi.investigation_name)
            AS sub_investigation_name,
        COALESCE(
            NULLIF(BTRIM(dmi.interpretation), ''),
            'No interpretations available at the moment'
        ) AS interpretation
    FROM dg_result_entry_header dreh
    JOIN dg_result_entry_detail dred
        ON dred.result_entry_id = dreh.result_entry_id
    JOIN current_order_tests cot
        ON cot.investigation_id = dred.investigation_id
    JOIN dg_sample_collection_details dscd
        ON dscd.sample_collection_details_id = dred.sample_collection_details_id
    JOIN dg_sample_collection_header dsch
        ON dsch.sample_collection_header_id = dscd.sample_collection_header_id
    JOIN dg_mas_investigation dmi
        ON dmi.investigation_id = dred.investigation_id
    LEFT JOIN dg_sub_mas_investigation dsmi
        ON dsmi.sub_investigation_id = dred.sub_investigation_id
    LEFT JOIN mas_sub_chargecode msc
        ON msc.sub_chargecode_id =
           COALESCE(dreh.sub_chargecode_id, dmi.sub_chargecode_id)
    LEFT JOIN dg_mas_sample dms
        ON dms.sample_id =
           COALESCE(dscd.sample_id, dred.sample_id, dmi.sample_id)
    WHERE dreh.order_hd_id = $P{orderhd_id}
      AND dred.validated = 'y'
)
SELECT DISTINCT
    co.orderhd_id AS order_hd_id,
    TO_CHAR(co.order_date, 'DD/MM/YYYY') AS order_date,
    co.order_no,
    co.patient_id AS hin_id,
    co.patient_address,
    co.mobile_no,
    co.uhid_no,
    co.patient_name,
    co.age_gender,
    co.ref_doctor,
    co.centre,
    co.uhid_no AS uhid,
    co.order_type,
    co.admission_no,
    co.patient_identifier,
    TO_CHAR(
        MAX(cr.collection_time) OVER (),
        'DD/Mon/YY HH12:MIAM'
    ) AS collection_datetime,
    TO_CHAR(
        MAX(
            CASE
                WHEN cr.result_date IS NOT NULL
                 AND NULLIF(BTRIM(cr.result_time), '') IS NOT NULL
                THEN cr.result_date::timestamp
                     + NULLIF(BTRIM(cr.result_time), '')::time
                ELSE cr.result_date::timestamp
            END
        ) OVER (),
        'DD/Mon/YY HH12:MIAM'
    ) AS result_datetime,
    cr.sub_chargecode_id,
    cr.investigation_id,
    cr.sample_id,
    cr.sub_chargecode_name,
    CONCAT_WS(',', cr.investigation_name, cr.sample_description)
        AS investigation_sample,
    cr.sub_investigation_name,
    cr.interpretation
FROM current_order co
JOIN current_results cr
    ON cr.order_hd_id = co.orderhd_id
ORDER BY
    cr.sub_chargecode_name,
    cr.investigation_id,
    cr.sample_id NULLS FIRST,
    cr.sub_investigation_name]]>
	</queryString>
