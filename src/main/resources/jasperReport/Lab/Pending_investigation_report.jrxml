	<parameter name="path" class="java.lang.String">
		<defaultValueExpression><![CDATA["/Users/rozaltheric/Downloads/arigen_health.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="hospital_id" class="java.lang.Long"/>
	<parameter name="from_date" class="java.util.Date">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="to_date" class="java.util.Date">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="sub_chargecode_id" class="java.lang.Long"/>
	<queryString language="SQL">
		<![CDATA[select
    mh.hospital_name,
    msc.sub_chargecode_name,
    hd.order_no,
    hd.order_date,
    concat(p.p_fn, ' ', coalesce(p.p_mn, ''), ' ', p.p_ln) as patient_name,
    p.p_age,
    mg.gender_name,
    p.p_mobile_number,
    dmi.investigation_name,
    dscd.sample_generated_id,
    lots.order_status_name
from dg_orderdt dt
inner join dg_orderhd hd on dt.orderhd_id = hd.orderhd_id
inner join lab_order_tracking_status lots on dt.order_tracking_status_id = lots.order_status_id
left join patient p on hd.patient_id = p.patient_id
left join mas_gender mg on p.p_gender_id = mg.id
left join dg_mas_investigation dmi on dt.investigation_id = dmi.investigation_id
left join mas_hospital mh on hd.hospital_id = mh.hospital_id
left join mas_sub_chargecode msc on dt.sub_chargeid = msc.sub_chargecode_id
left join (
    select 
        dsch.visit_id,
        dscd.investigation_id,
        min(dscd.sample_generated_id) as sample_generated_id
    from dg_sample_collection_header dsch
    join dg_sample_collection_details dscd on dsch.sample_collection_header_id = dscd.sample_collection_header_id
    group by dsch.visit_id, dscd.investigation_id
) dscd on dscd.visit_id = hd.visit_id and dscd.investigation_id = dt.investigation_id
where dt.order_tracking_status_id in (2,3,4,5)
  and hd.hospital_id = $P{hospital_id}
  and hd.order_date between $P{from_date} and $P{to_date}
  and (dt.sub_chargeid = $P{sub_chargecode_id} or $P{sub_chargecode_id} = 0)
order by hd.order_date desc]]>
	</queryString>
