		<property name="com.jaspersoft.studio.field.label" value="investigation_name"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="dg_mas_investigation"/>
	</field>
	<variable name="S.No." class="java.lang.Long" calculation="Count">
