	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="from_date" class="java.util.Date">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="to_date" class="java.util.Date">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="gender_id" class="java.lang.Long"/>
	<parameter name="investigation_id" class="java.lang.Long"/>
	<parameter name="from_age" class="java.lang.Long"/>
	<parameter name="to_age" class="java.lang.Long"/>
	<queryString>
		<![CDATA[select distinct 
	concat(pt.p_fn, ' ', pt.p_ln) as patient_name,
	cast(date_part('years', age(hd.result_date, pt.p_dob))as integer) as age,
	mg.gender_name as sex,
	dmi.investigation_name,
	to_char(hd.result_date, 'dd/MM/yyyy') as result_date,
	case 
	   when dt.result_type = 'm' then 'completed' 
	   else dt.result 
	end as result,
	case 
	   when dt.result_type = 'm' then '' 
	   else du.uom_name 
	end as uom_name,
	case 
	   when dt.result_type = 'm' then '' 
	   else dt.normal_range 
	end as range_value,
	pt.patient_id,
	dt.investigation_id
from dg_result_entry_header hd
left join dg_result_entry_detail dt on hd.result_entry_id = dt.result_entry_id
left join patient pt on hd.hin_id = pt.patient_id
left join mas_gender mg on pt.p_gender_id = mg.id
left join dg_mas_investigation dmi on dt.investigation_id = dmi.investigation_id
left join mas_sub_chargecode msc on hd.sub_chargecode_id = msc.sub_chargecode_id
left join dg_uom du on dmi.uom_id = du.uom_id
where hd.main_chargecode_id = 12 
and dt.validated = 'y'
and hd.result_status = 'y'
and dt.result is not null
	and hd.result_date between $P{from_date} and $P{to_date}
	and (dt.investigation_id = $P{investigation_id} or $P{investigation_id} = 0)
	and (pt.p_gender_id = $P{gender_id} or $P{gender_id} = 0)
	and cast(date_part('years', age(hd.result_date, pt.p_dob)) as bigint) 
    between $P{from_age} 
    and (case when $P{to_age} = 0 then 125 else $P{to_age} end)
order by 5, 1, 4]]>
	</queryString>
