<!-- Created with Jaspersoft Studio version 6.21.2.final using JasperReports Library version 6.20.1  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Result_amendment" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="e0563897-f811-4276-bd7f-8c8ea326c13b">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="hims_db"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="hospital_id" class="java.lang.Long"/>
	<parameter name="investigation_id" class="java.lang.Long"/>
	<parameter name="sub_chargecode_id" class="java.lang.Long"/>
	<parameter name="patient_name" class="java.lang.String"/>
	<parameter name="from_date" class="java.sql.Timestamp"/>
	<parameter name="to_date" class="java.sql.Timestamp"/>
	<parameter name="path" class="java.lang.String">
		<defaultValueExpression><![CDATA["/Users/rozaltheric/Downloads/arigen_health.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="mobile_no" class="java.lang.String"/>
	<queryString>
		<![CDATA[select distinct
	mh.hospital_name, 
	msc.sub_chargecode_name,
	ra.sample_generated_id,
	case 
		when p.p_mn is null then concat(p.p_fn, ' ', p.p_ln)
		else concat(p.p_fn, ' ', p.p_mn, ' ', p.p_ln)
	end as patient_name,
	dmi.investigation_name,
	concat(ra.old_result, ' ', du.uom_name) as old_result,
	concat(ra.new_result, ' ', du.uom_name) as new_result,
	mlat.amendment_name as reason_for_change,
	ra.amended_by,
	to_char(ra.amended_datetime, 'dd/MM/yyyy HH24:MI') as amended_datetime
from lab_result_amend_audit ra
left join patient p on ra.patient_id = p.patient_id
left join dg_mas_investigation dmi on ra.investigation_id = dmi.investigation_id
left join dg_uom du on dmi.uom_id = du.uom_id
left join mas_labresult_amendment_type mlat on ra.amendment_type_id = mlat.amendment_type_id
left join mas_hospital mh on p.p_hospital_id = mh.hospital_id
left join mas_sub_chargecode msc on dmi.sub_chargecode_id = msc.sub_chargecode_id
where
    p.p_hospital_id = $P{hospital_id}
    and (
        cast($P{from_date} as timestamp) is null
        or ra.amended_datetime >= cast($P{from_date} as timestamp)
    )
    and (
        cast($P{to_date} as timestamp) is null
        or ra.amended_datetime <= cast($P{to_date} as timestamp)
    )
    and (
        $P{mobile_no} is null
        or p.p_mobile_number = $P{mobile_no}
    )
    and (
        $P{patient_name} is null
        or concat_ws(' ', p.p_fn, p.p_mn, p.p_ln) ilike '%' || $P{patient_name} || '%'
    )
    and (
        $P{investigation_id} = 0
        or ra.investigation_id = $P{investigation_id}
    )
    and (
        $P{sub_chargecode_id} = 0
        or dmi.sub_chargecode_id = $P{sub_chargecode_id}
    )]]>
	</queryString>
