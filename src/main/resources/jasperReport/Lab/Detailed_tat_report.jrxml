	<parameter name="hospital_id" class="java.lang.Long"/>
	<parameter name="investigation_id" class="java.lang.Long"/>
	<parameter name="from_date" class="java.util.Date">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="to_date" class="java.util.Date">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="sub_chargecode_id" class="java.lang.Long"/>
	<parameter name="path" class="java.lang.String">
		<defaultValueExpression><![CDATA["/Users/rozaltheric/Downloads/arigen_health.png"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select 
	mh.hospital_name,
	msc.sub_chargecode_name,
	dmi.investigation_name,
	coalesce(tat.generated_sample_id, ' ') as generated_sample_id,
	to_char(tat.sample_collection_date_time, 'dd/MM/yyyy HH24:MI') as sample_collection_date_time,
	to_char(tat.result_validation_date_time, 'dd/MM/yyyy HH24:MI') as result_validation_date_time,
	dmi.tat_hours as expected_tat,
	floor(extract(
	  epoch from (tat.result_validation_date_time - tat.sample_collection_date_time)) / 3600
	)::int as actual_tat,	   
	lpad(greatest(
	  floor(extract(epoch from (tat.result_validation_date_time - tat.sample_collection_date_time)) / 3600)::int - dmi.tat_hours,0
	)::text,2,'0') as delay,
	case
	when floor(
		extract(epoch from (tat.result_validation_date_time - tat.sample_collection_date_time)) / 3600
	)::int > dmi.tat_hours then 'breached'
	else 'within'
	end as iau_status,
	tat.result_validated_by
from lab_turn_around_time tat
left join dg_mas_investigation dmi on tat.investigation_id = dmi.investigation_id
left join dg_orderhd doh on tat.order_hd_id = doh.orderhd_id
left join mas_hospital mh on doh.hospital_id = mh.hospital_id
left join mas_sub_chargecode msc on dmi.sub_chargecode_id = msc.sub_chargecode_id
where tat.result_validation_date_time is not null
and tat.is_reject = false
and doh.hospital_id = $P{hospital_id}
and doh.order_date between $P{from_date} and $P{to_date}
and ($P{investigation_id} is null or tat.investigation_id = $P{investigation_id})
and ($P{sub_chargecode_id} is null or dmi.sub_chargecode_id = $P{sub_chargecode_id})]]>
	</queryString>
