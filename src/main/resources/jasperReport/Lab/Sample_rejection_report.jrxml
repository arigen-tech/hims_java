	<parameter name="path" class="java.lang.String">
		<defaultValueExpression><![CDATA["/Users/rozaltheric/Downloads/arigen_health.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="hospital_id" class="java.lang.Long"/>
	<parameter name="from_date" class="java.util.Date">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="to_date" class="java.util.Date">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="sub_chargecode_id" class="java.lang.Long"/>
	<queryString language="SQL">
		<![CDATA[select
	mh.hospital_name,
	msc.sub_chargecode_name,
	doh.order_no,
	doh.order_date,
	concat(p.p_fn, '  ', coalesce(p.p_mn, ''), ' ', p.p_ln) as patient_name,
	p.p_age,
	mg.gender_name,
	p.p_mobile_number,
	dmi.investigation_name,
	dt.sample_generated_id,
	case dt.validated
		when 'r' then 'Rejected'
		when 'y' then 'Approved'
	end as status,
	dt.rejected_reason
from dg_sample_collection_details dt
left join dg_sample_collection_header hd on dt.sample_collection_header_id = hd.sample_collection_header_id
left join dg_orderhd doh on hd.visit_id = doh.visit_id
left join patient p on hd.patient_id = p.patient_id
left join mas_gender mg on p.p_gender_id = mg.id
left join dg_mas_investigation dmi on dt.investigation_id = dmi.investigation_id
left join mas_hospital mh on hd.hospital_id = mh.hospital_id
left join mas_sub_chargecode msc on hd.sub_charge_code_id = msc.sub_chargecode_id
where dt.validated = 'r'
and hd.hospital_id = $P{hospital_id}
and doh.order_date between $P{from_date} and $P{to_date}
and (hd.sub_charge_code_id = $P{sub_chargecode_id} or $P{sub_chargecode_id} = 0)]]>
	</queryString>
