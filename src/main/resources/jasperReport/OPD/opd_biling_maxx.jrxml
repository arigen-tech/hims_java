	<parameter name="visit_id" class="java.lang.String"/>
	<parameter name="path" class="java.lang.String">
		<defaultValueExpression><![CDATA["/Users/rozaltheric/Downloads/arigen_health.png"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[with visit_stats as (
    select count(distinct visit_id) as visit_count,
				sum(net_amount) as grand_total,
				sum(total_paid) as grand_total_paid
    from billing_header
    where visit_id = any (
    string_to_array($P{visit_id}, ',')::int[]
	)
)
select distinct
	bh.bill_hd_id,
	bh.visit_id,
	bh.hospital_address,
    p.p_mobile_number as patient_contact,
	case bh.patient_gender
		when 'Male' then concat('Mr.', bh.patient_display_name)
		when 'Female' then concat('Ms/Mrs.', bh.patient_display_name)
	end as patient_name,
    concat(bh.patient_age, '/', bh.patient_gender) as age_sex,
    bh.patient_address,    
    vi.doctor_name,
    cast(bh.billing_date as date) as bill_date,
    p.uhid_no as patient_id,
    bh.bill_no,
    coalesce(bh.gstn_bill_no, 'NA') as gstn_bill,
    coalesce(bh.hospital_gstin, 'NA') as gstn_no,
	concat(msc.service_cat_name, ' (' , md.department_name, ')') as opd_service_name,
    msc.sac_code,
	coalesce(bd.quantity, 1) as qty,
	bd.base_price,
	bd.discount as discount_amount,
	bd.amount_after_discount as net_amount,
	bd.tax_amount as tax_total,
	bd.net_amount as bill_amount,
	case 
        when vs.visit_count > 1 then vs.grand_total
        else bh.net_amount
    end as total,
    num_to_words(
        case 
            when vs.visit_count > 1 then vs.grand_total
            else bh.net_amount
        end
    ) as total_in_words,
	case
		when vs.visit_count > 1 then vs.grand_total_paid
		else bh.total_paid
	end as total_paid,
	coalesce(pd.payment_mode, 'cash') as payment_mode,
	coalesce(pd.payment_reference_no, 'NA') as payment_reference_number,
	cast(pd.payment_date as date) as payment_date,
	to_char(vi.visit_date, 'DD/MM/YYYY HH12:MMAM') as appointment_date,
	bh.created_by
from billing_details bd
left join mas_service_category msc on bd.service_category_id = msc.id
left join billing_header bh on bd.bill_hd_id = bh.bill_hd_id
left join patient p on bh.patient_id = p.patient_id
left join payment_details pd on bh.bill_hd_id = pd.billing_hd_id
left join visit vi on bh.visit_id = vi.visit_id
left join mas_department md on vi.department_id = md.department_id
left join dg_orderhd doh on vi.visit_id = doh.visit_id
cross join visit_stats vs
where bh.visit_id = any (
    string_to_array($P{visit_id}, ',')::int[]
)
group by 
	bh.hospital_address, p.p_mobile_number, bh.patient_display_name,bh.patient_age, bh.patient_gender, bh.patient_address, 
	vi.doctor_name, bh.billing_date ,p.uhid_no ,bh.bill_no ,bh.gstn_bill_no ,bh.hospital_gstin ,bh.visit_id ,msc.service_cat_name,
	msc.sac_code ,bd.quantity ,bd.base_price ,bd.discount ,bd.amount_after_discount ,bd.tax_amount ,bd.net_amount ,bh.net_amount, vs.visit_count,
	bh.total_paid,vs.grand_total, vs.grand_total_paid, pd.payment_mode, pd.payment_reference_no, pd.payment_date, vi.visit_date, md.department_name, bh.created_by, bh.bill_hd_id]]>
	</queryString>
