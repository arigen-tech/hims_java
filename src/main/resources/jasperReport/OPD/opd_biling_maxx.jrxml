		<parameter name="bill_id" class="java.lang.Long"/>
		<queryString language="SQL">
			<![CDATA[select 
        billing_hd_id,
        payment_mode,
        payment_reference_no,
        payment_date,
        amount
    from payment_details
	where billing_hd_id = $P{bill_id}]]>
