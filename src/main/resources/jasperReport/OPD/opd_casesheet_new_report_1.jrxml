	<queryString>
		<![CDATA[select
    v.visit_id,
    v.visit_date,
    mh.hospital_name,
    md.department_name,
    CONCAT(p.p_fn, ' ', p.p_ln) AS patient_name,
    p.p_mobile_number AS mobile_number,
    concat(concat(substring(p.p_age FROM '^(\d+)'), ' year(s) / '), mg.gender_name) as age_sex,
    p.uhid_no,
    concat(opd.height, ' cm') as height,
    concat(opd.weight, ' Kg') as weight,
    concat(opd.temperature, '°F') as temperature,
    concat(CONCAT(opd.bp_systolic, '/', opd.bp_diastolic), 'mmHg') AS blood_pressure,
    concat(opd.pulse, '/min') as pulse,
    concat(opd.spo2, '%') as spo2,
    concat(opd.bmi, 'kg/m²') as bmi,
    concat(opd.rr, '/min') as rr,
    CONCAT(
        me.emp_fn,
        ' ',
        COALESCE(me.emp_mn, ''),
        ' ',
        me.emp_ln
    ) AS doc_name,
    me.qualification,
    me.medical_registration_no,
    opd.icd_diag,
    opd.working_diag,
    opd.admission_flag,
    opd.referral_flag,
    opd.final_medical_advice,
    opd.follow_up_flag
FROM opd_patient_details opd
LEFT JOIN patient p ON opd.patient_id = p.patient_id
LEFT JOIN visit v ON opd.visit_id = v.visit_id
LEFT JOIN mas_hospital mh ON opd.hospital_id = mh.hospital_id
LEFT JOIN mas_department md ON opd.department_id = md.department_id
LEFT JOIN users u ON opd.doctor_id = u.user_id
LEFT JOIN mas_employee me ON u.employee_id = me.emp_id
left join mas_gender mg on p.p_gender_id = mg.id 
WHERE opd.visit_id = $P{visit_id}]]>
	</queryString>
