	</parameter>
	<queryString>
		<![CDATA[select
    v.visit_id,
    v.visit_date,
    mh.hospital_name,
    md.department_name,
    CONCAT(p.p_fn, ' ', p.p_ln) AS patient_name,
    p.p_mobile_number AS mobile_number,
    p.uhid_no,
    opd.height,
    opd.weight,
    opd.temperature,
    CONCAT(opd.bp_systolic, '/', opd.bp_diastolic) AS blood_pressure,
    opd.pulse,
    opd.spo2,
    opd.bmi,
    opd.rr,
    CONCAT(
        me.emp_fn,
        ' ',
        COALESCE(me.emp_mn, ''),
        ' ',
        me.emp_ln
    ) AS doc_name,
    me.qualification,
    me.medical_registration_no,
    opd.icd_diag,
    opd.working_diag,
    opd.admission_flag,
    opd.referral_flag
FROM opd_patient_details opd
LEFT JOIN patient p
    ON opd.patient_id = p.patient_id
LEFT JOIN visit v
    ON opd.visit_id = v.visit_id
LEFT JOIN mas_hospital mh
    ON opd.hospital_id = mh.hospital_id
LEFT JOIN mas_department md
    ON opd.department_id = md.department_id
LEFT JOIN users u
    ON opd.doctor_id = u.user_id
LEFT JOIN mas_employee me
    ON u.employee_id = me.emp_id
WHERE opd.visit_id = $P{visit_id}]]>
	</queryString>
