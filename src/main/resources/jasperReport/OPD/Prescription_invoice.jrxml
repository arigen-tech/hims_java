<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Prescription_invoice" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="9dc8aef2-a407-46f5-a6e5-8dbed0a3d192">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="hims_dev_db"/>
	<parameter name="prescriptionId" class="java.lang.Integer"/>
	<parameter name="path" class="java.lang.String">
		<defaultValueExpression><![CDATA["/Users/rozaltheric/Downloads/arigen_health.png"]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT
    bh.bill_hd_id,
    pph.prescription_hd_id ,
    bh.hospital_name,
    bh.invoice_no,
    TO_CHAR(bh.billing_date, 'DD/MM/YYYY HH12:MI AM') AS invoice_date,
    CONCAT_WS(' ', p.p_fn, NULLIF(p.p_mn, ''), NULLIF(p.p_ln, '')) AS patient_name,
    p.uhid_no,
    CASE
        WHEN p.p_age IS NOT NULL AND bh.patient_gender IS NOT NULL THEN SPLIT_PART(p.p_age, 'Y', 1) || ' / ' || bh.patient_gender
        WHEN p.p_age IS NOT NULL THEN SPLIT_PART(p.p_age, 'Y', 1)
        ELSE bh.patient_gender
    END AS age_gender,
    p.p_mobile_number,
    pph.prescription_number,
    pph.doctor_name,
    md.department_name,
    bd.item_name AS medicine_name,
    msi.drug_schedule ,
    msi.hsn_code,
    ppd.batch_no,
    TO_CHAR(ppd.expiry_date, 'Mon-YYYY') AS expiry_date,
    bd.quantity AS qty,
    bd.base_price AS rate,
    bd.discount AS discount,
    bd.tax_amount AS gst,
    bd.net_amount AS amount,
    bh.total_amount AS gross_amount,
    bh.discount_amount AS total_discount,
    (bh.net_amount - bh.tax_total) AS taxable_amount,
    bh.tax_total AS gst_amount,
    bh.net_amount AS net_amount,
    num_to_words(COALESCE(bh.net_amount, 0)) AS amount_in_words
FROM billing_header bh
INNER JOIN billing_details bd ON bd.bill_hd_id = bh.bill_hd_id
LEFT JOIN patient p ON p.patient_id = bh.patient_id
LEFT JOIN patient_prescription_hd pph ON pph.prescription_hd_id = bh.prescription_hd_id and pph.patient_id = bh.patient_id 
left join patient_prescription_dt ppd on ppd.prescription_hd_id = pph.prescription_hd_id and ppd.item_id = bd.item_id
LEFT JOIN mas_department md ON md.department_id = pph.department_id
left join mas_store_item msi on msi.item_id = bd.item_id 
where bd.service_category_id  = 3
and pph.prescription_hd_id = $P{prescriptionId}]]>
	</queryString>
