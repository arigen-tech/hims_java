	<parameter name="path" class="java.lang.String">
		<defaultValueExpression><![CDATA["/Users/rozaltheric/Downloads/arigen_health.png"]]></defaultValueExpression>
	</parameter>
	<parameter name="from_date" class="java.util.Date">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="to_date" class="java.util.Date">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="hospital_id" class="java.lang.Long"/>
	<parameter name="department_id" class="java.lang.Long"/>
	<parameter name="gender_id" class="java.lang.Long"/>
	<parameter name="doctor_id" class="java.lang.Long"/>
	<parameter name="icd_id" class="java.lang.Long"/>
	<queryString>
		<![CDATA[select distinct 
	vt.visit_id,
	mh.hospital_name,
    md.department_name, 
    concat(pt.p_fn, ' ', coalesce(pt.p_mn, ''), ' ', pt.p_ln) as patient_name,
    pt.p_dob,
    substring(pt.p_age from '([0-9]+)Y') as p_age,
    pt.uhid_no as patient_type,
	vt.doctor_name,
    mg.gender_name,
    vt.visit_date,
    opd.icd_diag,
    opd.patient_signs_symptoms,
    case when coalesce(opd.referral_flag, 'n') = 'n' then 'no' else 'yes' end referral_flag,
    case when coalesce(opd.medicine_flag, 'n') = 'n' then 'no' else 'yes' end madicine_flag,
    case when coalesce(opd.lab_flag, 'n') = 'n' then 'no' else 'yes' end lab_flag
from visit vt
left join patient pt on pt.patient_id = vt.patient_id
left join mas_gender mg on pt.p_gender_id = mg.id
left join opd_patient_details opd on opd.visit_id = vt.visit_id 
left join discharge_icd_code dic on dic.visit_id = vt.visit_id
left join mas_hospital mh on vt.hospital_id = mh.hospital_id
left join mas_department md on vt.department_id = md.department_id
where vt.visit_status ilike 'y'
and vt.visit_date::date between $P{from_date} and $P{to_date}
and (pt.p_gender_id = $P{gender_id} or $P{gender_id} = 0)
and (vt.department_id = $P{department_id} or $P{department_id} = 0)
and vt.hospital_id = $P{hospital_id}
and (dic.icd_id = $P{icd_id} or $P{icd_id} = 0)
and (vt.doctor_id = $P{doctor_id} or $P{doctor_id} = 0)
order by md.department_name, vt.visit_date]]>
	</queryString>
