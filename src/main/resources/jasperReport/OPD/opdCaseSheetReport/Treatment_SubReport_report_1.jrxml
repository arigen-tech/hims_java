	<parameter name="visit_id" class="java.lang.Long"/>
	<parameter name="option" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[select 
    msi.nomenclature,
    ppd.dosage,
    msu.unit_name,
    opd.recmmd_med_advice,
    ppd.frequency,
    ppd.days,
    ppd.total,
    ppd.instruction
from patient_prescription_dt ppd
left join patient_prescription_hd pph on pph.prescription_hd_id = ppd.prescription_hd_id
left join mas_store_item msi on msi.item_id = ppd.item_id
left join mas_store_unit msu on msu.unit_id = msi.unit_au
left join opd_patient_details opd on opd.patient_id = pph.patient_id
where opd.visit_id = $P{visit_id}
and $P{option} = 0
order by msi.nomenclature]]>
	</queryString>
