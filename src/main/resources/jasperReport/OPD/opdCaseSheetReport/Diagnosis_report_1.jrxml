	<parameter name="visit_id" class="java.lang.Long"/>
	<queryString>
		<![CDATA[select 
    opd.working_diag,
    opd.icd_diag
from patient p
left join visit v on p.patient_id = v.patient_id
left join opd_patient_details opd on opd.visit_id = v.visit_id
where v.visit_id = $P{visit_id}]]>
	</queryString>
