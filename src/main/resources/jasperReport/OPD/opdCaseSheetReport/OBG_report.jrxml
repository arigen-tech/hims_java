	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="visit_id" class="java.lang.Long"/>
	<queryString>
		<![CDATA[SELECT
    v.visit_id,
    p.patient_id,
    obg.obg_id,
    obg.opd_date,
    COALESCE(obg.obstetric_history_notes, '') AS obstetric_history_notes,
    COALESCE(obg.gravida, '') AS gravida,
    COALESCE(obg.para, '') AS para,
    COALESCE(obg.abortions, '') AS abortions,
    COALESCE(obg.living_children, '') AS living_children,
    COALESCE(obg.conception_type, '') AS conception_type,
    COALESCE(obg.married_life_years, '') AS married_life_years,
    COALESCE(obg.consanguinity, '') AS consanguinity,
    COALESCE(obg.booked_status, '') AS booked_status,
    COALESCE(obg.immunised_status, '') AS immunised_status,
    COALESCE(obg.trimester, '') AS trimester,
    COALESCE(obg.gc, '') AS gc,
    COALESCE(obg.pallor, '') AS pallor,
    COALESCE(obg.pedal_edema, '') AS pedal_edema,
    COALESCE(obg.respiratory_system, '') AS respiratory_system,
    COALESCE(obg.breath_sounds, '') AS breath_sounds,
    COALESCE(obg.cardiovascular_s1, '') AS cardiovascular_s1,
    COALESCE(obg.cardiovascular_s2, '') AS cardiovascular_s2,
    COALESCE(obg.cardiovascular_murmurs, '') AS cardiovascular_murmurs,
    COALESCE(obg.tt_status, '') AS tt_status,
    COALESCE(obg.fhr, '') AS fhr,
    COALESCE(obg.presentation, '') AS presentation,
    COALESCE(obg.palpation_notes, '') AS palpation_notes,
    COALESCE(obg.pv_done, '') AS pv_done,
    COALESCE(obg.uterus_height, '') AS uterus_height,
    COALESCE(obg.uterus_height_specify, '') AS uterus_height_specify,
    COALESCE(obg.antenatal_remarks, '') AS antenatal_remarks,
    COALESCE(obg.menarche_age, '') AS menarche_age,
    COALESCE(obg.cycles, '') AS cycles,
    COALESCE(obg.range_days, '') AS range_days,
    COALESCE(obg.interval_days, '') AS interval_days,
    COALESCE(obg.menstrual_flow, '') AS menstrual_flow,
    COALESCE(obg.menstrual_pause, '') AS menstrual_pause,
    COALESCE(obg.pv_os_dilatation, '') AS pv_os_dilatation,
    COALESCE(obg.pv_effacement, '') AS pv_effacement,
    COALESCE(obg.pv_membrane, '') AS pv_membrane,
    COALESCE(obg.pv_liquor, '') AS pv_liquor,
    COALESCE(obg.cervix_consistency, '') AS cervix_consistency,
    COALESCE(obg.cervix_position, '') AS cervix_position,
    COALESCE(obg.cervix_length, '') AS cervix_length,
    COALESCE(obg.station_presenting, '') AS station_presenting,
    COALESCE(obg.fetal_head, '') AS fetal_head,
    COALESCE(obg.pelvis, '') AS pelvis,
    COALESCE(obg.gyn_flow, '') AS gyn_flow,
    COALESCE(obg.gyn_menarche_age, '') AS gyn_menarche_age,
    obg.gyn_last_menstrual_period,
    COALESCE(obg.gyn_menstrual_pattern, '') AS gyn_menstrual_pattern,
    COALESCE(obg.gyn_cycle_type, '') AS gyn_cycle_type,
    COALESCE(obg.sterilisation, '') AS sterilisation,
    COALESCE(obg.abdomen_inspection, '') AS abdomen_inspection,
    COALESCE(obg.abdomen_palpation, '') AS abdomen_palpation,
    COALESCE(obg.pap_smear_result, '') AS pap_smear_result,
    COALESCE(obg.local_examination_notes, '') AS local_examination_notes,
    COALESCE(obg.per_speculum, '') AS per_speculum,
    COALESCE(obg.bimanual_examination, '') AS bimanual_examination,
    COALESCE(obg.gyn_obstetric_history, '') AS gyn_obstetric_history
from opd_obg_details obg
LEFT JOIN patient p ON p.patient_id = obg.patient_id
LEFT JOIN visit v ON v.visit_id = obg.visit_id 
	AND obg.patient_id = p.patient_id 
WHERE obg.visit_id = $P{visit_id}]]>
	</queryString>
