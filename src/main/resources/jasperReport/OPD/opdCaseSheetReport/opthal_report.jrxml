<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="opthal_report" pageWidth="421" pageHeight="842" columnWidth="421" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="32e7486e-7124-4912-8961-87fadd8fd195">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="hims_dev_db"/>
	<parameter name="visit_id" class="java.lang.Long"/>
	<queryString language="SQL">
		<![CDATA[SELECT
    opd_id,
    patient_id,
    visit_id,
    opd_date,

    -- Vision / Visual Acuity: Right Eye (R.E.)
    re_distance_unaided,
    re_distance_pinhole,
    re_distance_best_corrected,
    re_near_unaided,
    re_near_pinhole,
    re_near_best_corrected,

    -- Vision / Visual Acuity: Left Eye (L.E.)
    le_distance_unaided,
    le_distance_pinhole,
    le_distance_best_corrected,
    le_near_unaided,
    le_near_pinhole,
    le_near_best_corrected,

    -- Spectacle Prescription: Distance
    re_sph_dist,
    re_cyl_dist,
    re_axis_dist,
    le_sph_dist,
    le_cyl_dist,
    le_axis_dist,

    -- Spectacle Prescription: Near
    re_sph_near,
    re_cyl_near,
    re_axis_near,
    le_sph_near,
    le_cyl_near,
    le_axis_near,

    -- Spectacle Details
    ipd_value,
    spectacle_use,
    lens_type

FROM public.opd_opth_details
WHERE visit_id = $P{visit_id}]]>
	</queryString>
