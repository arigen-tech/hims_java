	<parameter name="visit_id" class="java.lang.Long"/>
	<queryString>
		<![CDATA[select
	md.department_name,
	opd.ref_doctor_name ,
	opd.referral_remark 
from opd_patient_details opd 
left join mas_department md on opd.referral_dept_id = md.department_id 
where opd.visit_id = $P{visit_id}]]>
	</queryString>
