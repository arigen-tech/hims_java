	<parameter name="visit_id" class="java.lang.Long"/>
	<queryString language="SQL">
		<![CDATA[select
	dpt.created_date,
	mtm.tooth_number,
	mp.procedure_name,
	pd.planned_session_count ,
	pd.remarks
from dental_procedure_tooth dpt 
left join mas_tooth_master mtm on dpt.tooth_id = mtm.tooth_id 
left join procedure_dt pd on dpt.procedure_dt_id = pd.procedure_dt_id 
left join procedure_hd ph on pd.procedure_hd_id = ph.procedure_hd_id
left join mas_procedure mp on pd.procedure_id = mp.procedure_id
where ph.visit_id = $P{visit_id}
order by pd.sequence_no]]>
	</queryString>
