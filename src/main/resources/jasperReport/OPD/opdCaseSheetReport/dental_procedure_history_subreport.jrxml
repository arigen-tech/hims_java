	<subDataset name="tooth" uuid="2d460d04-9be7-4351-80f0-1e8a1d621cb5">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="hims_dev_db"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="visit_id" class="java.lang.Long"/>
		<parameter name="tooth_type" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT
    tm.tooth_id,
    tm.tooth_number,
    tm.tooth_type,
    tm.quadrant,
    tm.display_order,

    pc.patient_id,
    pc.visit_id,

    COALESCE(pc.condition_id, 1) AS condition_id,

    STRING_AGG(
        DISTINCT mc.condition_name,
        ', ' ORDER BY mc.condition_name
    ) AS condition_names,

    STRING_AGG(
        DISTINCT NULLIF(TRIM(pc.remarks), ''),
        '; '
    ) AS remarks,

    CASE
        WHEN tm.quadrant IN (1, 2) THEN 'Upper Jaw'
        WHEN tm.quadrant IN (3, 4) THEN 'Lower Jaw'
        ELSE ''
    END AS jaw

FROM public.opd_tooth_patient_condition pc
RIGHT JOIN public.mas_tooth_master tm
    ON tm.tooth_id = pc.tooth_id
   AND pc.visit_id = $P{visit_id}
LEFT JOIN public.mas_tooth_condition mc
    ON mc.condition_id = pc.condition_id
where tm.tooth_type = $P{tooth_type}

GROUP BY
    tm.tooth_id,
    tm.tooth_number,
    tm.tooth_type,
    tm.quadrant,
    tm.display_order,
    pc.patient_id,
    pc.visit_id,
    pc.condition_id

ORDER BY tm.display_order]]>
		</queryString>
