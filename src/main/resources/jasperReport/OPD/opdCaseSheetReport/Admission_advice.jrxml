	<parameter name="visit_id" class="java.lang.Long"/>
	<queryString>
		<![CDATA[select 
	opd.admission_advised_date ,
	opd.admission_remarks ,
	mcl.care_level_name ,
	mw.ward_name ,
	mwc.ward_category_name ,
	opd.admission_priority 
from opd_patient_details opd
left join mas_care_level mcl on opd.admission_care_level_id = mcl.care_id 
left join mas_ward_category mwc on opd.admission_ward_category_id = mwc.ward_category_id  
left join mas_ward mw on opd.admission_ward_id = mw.ward_id 
where opd.visit_id = $P{visit_id}]]>
	</queryString>
