		<field name="jaw" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="jaw"/>
			<property name="com.jaspersoft.studio.field.label" value="jaw"/>
		</field>
	</subDataset>
	<parameter name="visit_id" class="java.lang.Long"/>
	<queryString>
		<![CDATA[select
	otpc.visit_id,
	tm.tooth_type
from opd_tooth_patient_condition otpc
left join mas_tooth_master tm
    ON tm.tooth_id = otpc.tooth_id
where otpc.visit_id = $P{visit_id}]]>
	</queryString>
