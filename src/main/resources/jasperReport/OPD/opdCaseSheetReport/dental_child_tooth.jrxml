	<style name="tooth_condition_style" mode="Opaque" backcolor="#FFC107">
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{condition_id} != null &&
	            $F{condition_id}.trim().equals("1")]]></conditionExpression>
			<style backcolor="#198764"/>
		</conditionalStyle>
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{condition_id} != null &&
	            $F{condition_id}.trim().equals("11")]]></conditionExpression>
			<style backcolor="#DC3545"/>
		</conditionalStyle>
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{condition_id} != null &&
