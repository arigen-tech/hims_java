	<parameter name="visit_id" class="java.lang.Long"/>
	<queryString>
		<![CDATA[select dmi.investigation_name
from dg_orderdt dt 
left join dg_orderhd hd on hd.orderhd_id = dt.orderhd_id
left join dg_mas_investigation dmi on dmi.investigation_id = dt.investigation_id
left join mas_main_chargecode mmc on mmc.main_chargecode_id = dmi.main_chargecode_id
left join opd_patient_details opd on opd.visit_id = hd.visit_id 
where hd.visit_id=$P{visit_id}]]>
	</queryString>
	<field name="investigation_name" class="java.lang.String"/>
	<variable name="Srno" class="java.lang.Integer" calculation="Count">
