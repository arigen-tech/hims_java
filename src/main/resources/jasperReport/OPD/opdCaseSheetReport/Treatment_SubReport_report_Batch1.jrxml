	<parameter name="visit_id" class="java.lang.Long"/>
	<queryString>
		<![CDATA[select sum(aks.st_flag) st_flag, aks.visit_id
from (
    select 
		case 
			when sit.stock_id is null then 0 
			else 1 
		end as st_flag,
		opd.visit_id
	from patient_prescription_hd pph
	inner join patient_prescription_dt ppd on pph.prescription_hd_id = ppd.prescription_hd_id
	left join store_issue_t sit on sit.prescription_dt_id = ppd.prescription_dt_id
	left join store_item_batch_stock sibs on sibs.stock_id = sit.stock_id
	left join opd_patient_details opd on pph.patient_id = opd.patient_id
	where opd.visit_id = $P{visit_id}
	) as aks
group by aks.visit_id]]>
	</queryString>
	<field name="st_flag" class="java.lang.Integer"/>
	<field name="visit_id" class="java.lang.Long"/>
	<variable name="Srno" class="java.lang.Integer" calculation="Count">
