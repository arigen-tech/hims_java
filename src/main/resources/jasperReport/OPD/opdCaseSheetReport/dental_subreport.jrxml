	<parameter name="visit_id" class="java.lang.Long"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA["D:\\hims_java\\src\\main\\resources\\jasperReport\\OPD\\opdCaseSheetReport\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	opds.total_teeth,
	opds.missing_teeth,
	opds.unsalvageable_teeth,
	opds.affected_teeth ,
	opds.ongoing_procedures,
	opds.dental_disease_score ,
	mtm.tooth_type,
	otpc.remarks
from opd_patient_dental_summary opds
left join opd_tooth_patient_condition otpc 
	on opds.visit_id = otpc.visit_id and opds.patient_id = otpc.patient_id 
left join mas_tooth_master mtm on otpc.tooth_id = mtm.tooth_id 
 where opds.visit_id = $P{visit_id}]]>
	</queryString>
