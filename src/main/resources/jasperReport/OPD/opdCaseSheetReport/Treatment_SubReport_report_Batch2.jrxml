	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="visit_id" class="java.lang.Long"/>
	<parameter name="option" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[select 
    ppd.total * sibs.mrp_per_unit as rate,
    msi.nomenclature,
    ppd.dosage,
    msu.unit_name,
    opd.recmmd_med_advice,
    ppd.frequency,
    ppd.days,
    ppd.total as total,
    ppd.instruction,
    sibs.mrp_per_unit as mrp,
    ppd.issued_qty
from 
patient_prescription_dt ppd
left join patient_prescription_hd pph on pph.prescription_hd_id = ppd.prescription_hd_id
left join mas_store_item msi on msi.item_id = ppd.item_id
left join mas_store_unit msu on msu.unit_id = msi.unit_au
left join opd_patient_details opd 
		on opd.patient_id = pph.patient_id 
		and opd.visit_id = pph.visit_id 
left join store_issue_t sit on sit.prescription_dt_id = ppd.prescription_dt_id
left join store_item_batch_stock sibs on sibs.stock_id = sit.stock_id
where opd.visit_id = $P{visit_id}
and $P{option} <> 0
order by msi.nomenclature]]>
	</queryString>
