	<parameter name="visit_id" class="java.lang.Long"/>
	<queryString>
		<![CDATA[select 
	obrh.surgery_level ,
	mot.ot_name,
	obrh.preferred_date ,
	obrh.preferred_start_time ,
	obrh.preferred_end_time,
	ms.surgery_name 
from ot_booking_request_hd obrh 
left join mas_operation_theatre mot on obrh.preferred_ot_id = mot.ot_id 
left join ot_booking_request_dt obrd on obrd.ot_booking_request_id = obrh.ot_booking_request_id 
left join mas_surgery ms on obrd.surgery_id = ms.surgery_id 
where obrh.visit_id = $P{visit_id}]]>
	</queryString>
