	<parameter name="prescriptionId" class="java.lang.Integer"/>
	<parameter name="path" class="java.lang.String">
		<defaultValueExpression><![CDATA["/Users/rozaltheric/Downloads/arigen_health.png"]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT
    sim.store_issue_m_id,
    sim.issue_no,
    TO_CHAR(sim.issue_date, 'DD/MM/YYYY HH12:MI AM') AS issue_date,
    pph.prescription_number,
    TO_CHAR(pph.prescription_date, 'DD/MM/YYYY HH12:MI AM') AS prescription_date,
    mh.hospital_name,
    CONCAT_WS(' ', p.p_fn, NULLIF(p.p_mn, ''), NULLIF(p.p_ln, '')) AS patient_name,
    p.uhid_no,
    CASE
        WHEN p.p_age IS NOT NULL AND mg.gender_code IS NOT NULL THEN SPLIT_PART(p.p_age, 'Y', 1) || ' / ' || mg.gender_code
        WHEN p.p_age IS NOT NULL THEN SPLIT_PART(p.p_age, 'Y', 1)
        ELSE mg.gender_code
    END AS age_gender,
    p.p_mobile_number,
    pph.doctor_name,
    md.department_name,
    msi.nomenclature AS medicine_name,
    ppd.frequency,
    ppd.days,
    sit.batch_no,
    TO_CHAR(sit.expiry_date, 'Mon-YYYY') AS expiry_date,
    sit.issued_qty,
    ppd.dosage,
    msi.dosage_unit,
    ppd.instruction,
    sim.issued_by
FROM store_issue_m sim
INNER JOIN store_issue_t sit ON sit.store_issue_m_id = sim.store_issue_m_id
INNER JOIN patient p ON p.patient_id = sim.patient_id
LEFT JOIN patient_prescription_hd pph ON pph.prescription_hd_id = sim.prescription_hd_id
LEFT JOIN patient_prescription_dt ppd ON ppd.prescription_dt_id = sit.prescription_dt_id
LEFT JOIN mas_hospital mh ON mh.hospital_id = sim.hospital_id
LEFT JOIN mas_department md ON md.department_id = pph.department_id  
LEFT JOIN mas_gender mg ON mg.id = p.p_gender_id
LEFT JOIN mas_store_item msi ON msi.item_id = sit.item_id
WHERE sim.prescription_hd_id = $P{prescriptionId}
and pph.status = 'y']]>
	</queryString>
